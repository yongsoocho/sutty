<UserControl
    x:Class="sutty.UI.Controls.HostCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  컴팩트 카드: 사진 없이 색 점 + 2줄 텍스트. 클릭하면 바로 연결.  -->
    <Border
        x:Name="CardRoot"
        Padding="10,7"
        Background="{ThemeResource CardBg}"
        BorderBrush="{ThemeResource CardBorder}"
        BorderThickness="1"
        CornerRadius="8"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        Tapped="Card_Tapped">

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  호스트 색 점 (기존 로고 배경색 재활용)  -->
            <Ellipse
                Grid.Column="0"
                Width="9"
                Height="9"
                VerticalAlignment="Center"
                Fill="{x:Bind Host.LogoBg, FallbackValue=#5B9CFF}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="{x:Bind Host.Hostname}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextMuted}"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind Host.Alias}" />
                    <Run Text=" · " />
                    <Run Text="{x:Bind Host.IP}" />
                </TextBlock>
            </StackPanel>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource TextFaint}"
                Text="{x:Bind Host.LastConnectedText}" />
        </Grid>
    </Border>
</UserControl>
