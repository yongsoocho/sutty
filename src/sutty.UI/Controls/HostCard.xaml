<UserControl
    x:Class="sutty.UI.Controls.HostCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        작은 반응형 카드 (UniformGridLayout에서 한 줄에 여러 개).
        정보는 그대로: alias / hostname / 마지막 접속. 클릭하면 바로 연결.
    -->
    <Border
        x:Name="CardRoot"
        Padding="10,8"
        Background="{ThemeResource CardBg}"
        BorderBrush="{ThemeResource CardBorder}"
        BorderThickness="1"
        CornerRadius="8"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        Tapped="Card_Tapped">

        <StackPanel Spacing="2">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="{x:Bind Host.Alias}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Host.Alias}" />
                <!--  상단 고정 카드에만 보이는 접속 횟수 배지  -->
                <Border
                    Grid.Column="1"
                    Padding="5,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource PillBg}"
                    CornerRadius="8"
                    Visibility="{x:Bind Host.HasCount}">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource AccentBlue}"
                        Text="{x:Bind Host.CountText}" />
                </Border>
            </Grid>
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind Host.Hostname}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontSize="10"
                Foreground="{ThemeResource TextFaint}"
                Text="{x:Bind Host.LastConnectedText}" />
        </StackPanel>
    </Border>
</UserControl>
