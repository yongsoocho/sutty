<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.CommandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  헤더  -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="{ThemeResource AccentTeal}" Style="{StaticResource HeaderDot}" />
            <TextBlock
                FontSize="20"
                FontWeight="Medium"
                Foreground="{ThemeResource TextPrimary}"
                Text="Commands" />
        </StackPanel>

        <!--  새 명령 추가  -->
        <Expander
            x:Name="AddExpander"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{ThemeResource CardBg}"
            BorderBrush="{ThemeResource CardBorder}"
            CornerRadius="10"
            Header="+ New command">
            <StackPanel Padding="0,8,0,4" Spacing="10">
                <TextBox
                    x:Name="NewNameBox"
                    PlaceholderText="Name (e.g. Create LV)"
                    Style="{StaticResource DarkInput}" />
                <TextBox
                    x:Name="NewTextBox"
                    FontFamily="Cascadia Mono, Consolas"
                    PlaceholderText="lvcreate -n $1 -L $2"
                    Style="{StaticResource DarkInput}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFaint}"
                    Text="$1, $2 … 자리표시자를 넣으면 실행할 때 값을 입력받습니다."
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AccentBlue}"
                    Click="Add_Click"
                    Content="Add"
                    CornerRadius="8"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF" />
            </StackPanel>
        </Expander>

        <!--  저장된 playbook 목록 (자주 쓰는 순)  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,16">
                <ItemsControl x:Name="CommandsList" ItemsSource="{x:Bind Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommandItemVm">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12,10"
                                Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimary}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!--  실행 (자리표시자가 있으면 입력칸이 펼쳐짐)  -->
                                        <Button
                                            Grid.Column="1"
                                            Padding="6,4"
                                            Background="{ThemeResource PillBg}"
                                            BorderBrush="{ThemeResource CardBorder}"
                                            Click="Run_Click"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Run in current session">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentBlue}"
                                                Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Padding="6,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="Delete_Click"
                                            ToolTipService.ToolTip="Delete">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFaint}"
                                                Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextMuted}"
                                        Text="{x:Bind CommandText}"
                                        TextWrapping="Wrap" />

                                    <!--  $n 입력칸: Run을 누르면 펼쳐진다  -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ShowParams, Mode=OneWay}">
                                        <ItemsControl ItemsSource="{x:Bind Params}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommandParamVm">
                                                    <TextBox
                                                        Margin="0,0,0,6"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="12"
                                                        PlaceholderText="{x:Bind Label}"
                                                        Text="{x:Bind Value, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Background="{ThemeResource AccentBlue}"
                                            Click="Execute_Click"
                                            Content="Run"
                                            CornerRadius="6"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#FFFFFF" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    x:Name="EmptyText"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFaint}"
                    Text="No saved commands yet"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
