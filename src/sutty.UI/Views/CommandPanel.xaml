<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.CommandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  헤더  -->
        <StackPanel Spacing="5">
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="{x:Bind h:Loc.T('명령 모음집', 'Command library')}" />
            <TextBlock
                x:Name="RunTargetHint"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('저장 명령도 체크한 세션에만 전송합니다.', 'Saved commands also run only on checked sessions.')}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  검색  -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            MinHeight="36"
            CornerRadius="7"
            FontSize="12.5"
            PlaceholderText="{x:Bind h:Loc.T('명령어 검색...', 'Search commands...')}"
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged" />

        <!--  새 명령 추가  -->
        <Expander
            x:Name="AddExpander"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{ThemeResource CardBg}"
            BorderBrush="{ThemeResource CardBorder}"
            CornerRadius="8"
            FontSize="12"
            Foreground="{ThemeResource AccentTeal}"
            Header="{x:Bind h:Loc.T('+ 새 명령', '+ New command')}">
            <StackPanel Padding="0,8,0,10" Spacing="8">
                <TextBox
                    x:Name="NewNameBox"
                    FontSize="12"
                    MinHeight="34"
                    PlaceholderText="{x:Bind h:Loc.T('이름 (예: 디스크 사용량)', 'Name (e.g. Disk usage)')}"
                    Style="{StaticResource DarkInput}" />
                <TextBox
                    x:Name="NewTextBox"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11.5"
                    MinHeight="34"
                    PlaceholderText="lvcreate -n $1 -L $2"
                    Style="{StaticResource DarkInput}" />
                <TextBlock
                    FontSize="10.5"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('$1, $2 … 자리표시자를 넣으면 실행할 때 값을 입력받습니다.', 'Use $1, $2 … placeholders to be prompted for values at run time.')}"
                    TextWrapping="Wrap" />
                <Button
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AccentGradient}"
                    BorderThickness="0"
                    Click="Add_Click"
                    Content="{x:Bind h:Loc.T('추가', 'Add')}"
                    CornerRadius="7"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentForeground}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentGradientHover" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentGradient" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Expander>

        <!--  저장된 playbook 목록 (자주 쓰는 순)  -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,0,0,12">
                <ItemsControl x:Name="CommandsList" ItemsSource="{x:Bind Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommandItemVm">
                            <Border
                                Margin="0,0,0,6"
                                Padding="11,10"
                                Background="{ThemeResource CardBg}"
                                BorderBrush="{ThemeResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimary}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!--  실행 (자리표시자가 있으면 입력칸이 펼쳐짐)  -->
                                        <Button
                                            Grid.Column="1"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            Background="{ThemeResource AccentTint}"
                                            BorderThickness="0"
                                            Click="Run_Click"
                                            CornerRadius="5"
                                            ToolTipService.ToolTip="{x:Bind h:Loc.T('명령 실행', 'Run command')}">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentBlue}"
                                                Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="Delete_Click"
                                            ToolTipService.ToolTip="{x:Bind h:Loc.T('삭제', 'Delete')}">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFaint}"
                                                Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>

                                    <Border
                                        Padding="8,6"
                                        Background="{ThemeResource InputBg}"
                                        CornerRadius="5">
                                        <TextBlock
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextMuted}"
                                            Text="{x:Bind CommandText}"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <!--  $n 입력칸: Run을 누르면 펼쳐진다  -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ShowParams, Mode=OneWay}">
                                        <ItemsControl ItemsSource="{x:Bind Params}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommandParamVm">
                                                    <TextBox
                                                        Margin="0,0,0,6"
                                                        MinHeight="32"
                                                        CornerRadius="6"
                                                        FontFamily="Cascadia Mono, Consolas"
                                                        FontSize="11.5"
                                                        PlaceholderText="{x:Bind Label}"
                                                        Text="{x:Bind Value, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            Height="30"
                                            HorizontalAlignment="Stretch"
                                            Background="{ThemeResource AccentGradient}"
                                            BorderThickness="0"
                                            Click="Execute_Click"
                                            Content="{x:Bind h:Loc.T('실행', 'Run')}"
                                            CornerRadius="6"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentForeground}">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentGradientHover" />
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentGradient" />
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    x:Name="EmptyText"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextMuted}"
                    TextWrapping="Wrap"
                    Text="{x:Bind h:Loc.T('저장된 명령이 없습니다', 'No saved commands yet')}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </ScrollViewer>
</UserControl>
