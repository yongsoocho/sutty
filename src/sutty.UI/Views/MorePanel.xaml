<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.MorePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="{StaticResource StatusAmber}" Style="{StaticResource HeaderDot}" />
            <TextBlock
                FontSize="20"
                FontWeight="Medium"
                Foreground="{ThemeResource TextPrimary}"
                Text="More" />
        </StackPanel>
        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextMuted}"
            Text="Nothing here yet — port forwarding, snippets and macros will live here." />
    </StackPanel>
</UserControl>
