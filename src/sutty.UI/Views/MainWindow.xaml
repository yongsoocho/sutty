<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="sutty.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="sutty"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Transparent, draggable title bar — lets the Mica backdrop show through the top  -->
        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <Image
                Width="20"
                Height="20"
                Margin="14,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="80" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" MinWidth="80" />
            </Grid.ColumnDefinitions>

            <!--  Left panel  -->
        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Border>

        <!--  Drag line between left and center  -->
        <controls:GridSplitter
            Grid.Column="1"
            Width="12"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Auto" />

        <!--  Center panel: Chrome-style tabs with a "+" add button on the right  -->
        <TabView
            x:Name="CenterTabs"
            Grid.Column="2"
            AddTabButtonClick="CenterTabs_AddTabButtonClick"
            TabCloseRequested="CenterTabs_TabCloseRequested">
            <TabView.TabItems>
                <TabViewItem Header="Tab 1" IsClosable="True">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Document" />
                    </TabViewItem.IconSource>
                    <Grid Background="{ThemeResource LayerFillColorAltBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Page 1" />
                    </Grid>
                </TabViewItem>
                <TabViewItem Header="Tab 2" IsClosable="True">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Document" />
                    </TabViewItem.IconSource>
                    <Grid Background="{ThemeResource LayerFillColorAltBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Page 2" />
                    </Grid>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

        <!--  Drag line between center and right  -->
        <controls:GridSplitter
            Grid.Column="3"
            Width="12"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Auto" />

        <!--  Right panel  -->
        <Border Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Right" />
        </Border>
        </Grid>
    </Grid>
</Window>
