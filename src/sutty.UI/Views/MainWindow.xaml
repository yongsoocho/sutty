<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="sutty.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    Title="Sutty"
    mc:Ignorable="d">
    <!--  테마(Dark/Light)는 코드에서 설정값으로 지정하고, 우상단 토글로 전환한다  -->
    <Grid
        x:Name="Root"
        Background="{ThemeResource AppBg}"
        PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition
                x:Name="RightPanelColumn"
                Width="316"
                MinWidth="300"
                MaxWidth="800" />
        </Grid.ColumnDefinitions>

        <!--  타이틀 스트립 배경 (시각용, 전체 폭)  -->
        <Border
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="38"
            VerticalAlignment="Top"
            Background="{ThemeResource AppBg}" />

        <!--
            창 드래그 영역: 탭/버튼 같은 인터랙티브 컨트롤은 이 위에 그려지므로
            빈 곳 어디서든 드래그로 창을 옮길 수 있다. (SetTitleBar 대상)
        -->
        <Grid
            x:Name="TitleBarDragRegion"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="38"
            VerticalAlignment="Top"
            Background="Transparent" />

        <!--  ── Column 0: Logo + Left Nav Rail ──  -->
        <Grid Grid.Column="0" Background="{ThemeResource RailBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  디자인 원본 로고 (좀 더 크게)  -->
            <Image
                Grid.Row="0"
                Width="32"
                Height="32"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/sutty.targetsize-48.png" />
            <NavigationView
                x:Name="LeftNav"
                Grid.Row="1"
                Margin="0,12,0,0"
                AlwaysShowHeader="False"
                Background="Transparent"
                CompactPaneLength="48"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="False"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                ItemInvoked="LeftNav_ItemInvoked"
                OpenPaneLength="48"
                PaneDisplayMode="LeftCompact"
                SelectionChanged="LeftNav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Home"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        Content="Search"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        Content="Folder"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Folder">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <!--  Command: 자주 쓰는 명령어 playbook (디자인: 번개 아이콘)  -->
                    <NavigationViewItem
                        Content="Command"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Command">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE945;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <!--  Multi: 여러 세션에 동시에 명령 브로드캐스트  -->
                    <NavigationViewItem
                        Content="Multi"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Multi">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8A9;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem
                        Content="{x:Bind h:Loc.T('로그', 'Logs')}"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Logs">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        Content="Setting"
                        SelectsOnInvoked="False"
                        Style="{StaticResource CompactRailItem}"
                        Tag="Setting">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource CompactRailIcon}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
            </NavigationView>

            <!--
                Draw the divider over the rail so it does not steal one pixel
                from NavigationView's 48px compact-pane layout.
            -->
            <Border
                Grid.RowSpan="2"
                Width="1"
                HorizontalAlignment="Right"
                Background="{ThemeResource ShellBorder}"
                Canvas.ZIndex="1"
                IsHitTestVisible="False" />
        </Grid>

        <!--  ── Column 1: Tabs + Main Content ──  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                세션 탭: Connect 할 때마다 코드에서 TabViewItem이 추가된다.
                HorizontalAlignment=Left 로 탭 폭만큼만 차지 → 나머지는 드래그 영역.
            -->
            <TabView
                x:Name="TitleTabs"
                Grid.Row="0"
                Height="38"
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                IsAddTabButtonVisible="True"
                AddTabButtonClick="TitleTabs_AddTabButtonClick"
                SelectionChanged="TitleTabs_SelectionChanged"
                TabCloseRequested="TitleTabs_TabCloseRequested"
                TabWidthMode="SizeToContent">
                <TabView.TabStripHeader>
                    <!--
                        Chrome keeps a selected tab in the strip even on its start page.
                        This visual-only tab gives the adjacent + button the same anchor
                        while Sutty has no local or SSH tabs yet.
                    -->
                    <Border
                        x:Name="EmptyTabHeader"
                        Width="156"
                        Height="32"
                        Margin="2,6,0,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="New tab"
                        Background="{ThemeResource PanelBg}"
                        BorderBrush="{ThemeResource ShellBorder}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0"
                        IsHitTestVisible="False">
                        <StackPanel
                            Margin="12,0,10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource StatusIdle}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimary}"
                                Text="{x:Bind h:Loc.T('새 탭', 'New tab')}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{ThemeResource TextFaint}"
                                Text="PowerShell" />
                        </StackPanel>
                    </Border>
                </TabView.TabStripHeader>
            </TabView>

            <!--  Main Content: 선택된 탭의 SessionView (Multi 모드에서는 4×4 그리드)  -->
            <Grid Grid.Row="1" Background="{ThemeResource PanelBg}">
                <ContentControl
                    x:Name="SessionHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <local:MultiSessionGrid x:Name="MultiGrid" Visibility="Collapsed" />
                <StackPanel
                    x:Name="NoSessionState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="34"
                        Foreground="{ThemeResource TextMuted}"
                        Glyph="&#xE756;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextMuted}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind h:Loc.T('활성 탭 없음', 'No active tabs')}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextMuted}"
                        Text="{x:Bind h:Loc.T('Home에서 SSH에 연결하거나 +로 로컬 PowerShell을 여세요 (최대 16개)', 'Connect to SSH from Home or use + for local PowerShell (max 16)')}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ── Column 2: 오른쪽 패널 크기 조절 스플리터 ──  -->
        <sizers:GridSplitter
            Grid.Column="1"
            Width="8"
            Margin="0,38,-4,0"
            HorizontalAlignment="Right"
            AutomationProperties.Name="Resize side panel"
            Background="Transparent"
            Canvas.ZIndex="10"
            ResizeBehavior="CurrentAndNext"
            ResizeDirection="Columns" />

        <!--  ── Column 3: Right Panel ──  -->
        <Grid x:Name="RightPanelHost" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                Padding="16"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SidePanelBg}"
                BorderBrush="{ThemeResource ShellBorder}"
                BorderThickness="1,0,0,0">
                <ContentControl
                    x:Name="RightPanel"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</Window>
