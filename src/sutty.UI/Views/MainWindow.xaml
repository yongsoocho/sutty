<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="sutty.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="sutty"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="336" />
        </Grid.ColumnDefinitions>
        <!--  ── Column 0: Logo + Left Nav Rail ──  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#121E31" />
                    <GradientStop Offset="1.0" Color="#0B111E" />
                </LinearGradientBrush>
            </Grid.Background>

            <Image
                Grid.Row="0"
                Width="24"
                Height="24"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/sutty.altform-lightunplated_targetsize-48.png" />
            <NavigationView
                x:Name="LeftNav"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                ItemInvoked="LeftNav_ItemInvoked"
                PaneDisplayMode="LeftCompact"
                SelectionChanged="LeftNav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="Search" Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="Folder" Tag="Folder">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="More" Tag="More">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE712;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        Content="Setting"
                        Icon="Setting"
                        SelectsOnInvoked="False"
                        Tag="Setting" />
                </NavigationView.FooterMenuItems>
            </NavigationView>
        </Grid>
        <!--  ── Column 1: Tabs + Main Content ──  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  TabView: Tabs  -->
            <!--  세션 탭: Connect 할 때마다 코드에서 TabViewItem이 추가된다  -->
            <TabView
                x:Name="TitleTabs"
                Grid.Row="0"
                VerticalAlignment="Stretch"
                IsAddTabButtonVisible="False"
                SelectionChanged="TitleTabs_SelectionChanged"
                TabCloseRequested="TitleTabs_TabCloseRequested"
                TabWidthMode="SizeToContent">
                <TabView.TabStripFooter>
                    <Grid x:Name="CustomDragRegion" Background="Transparent" />
                </TabView.TabStripFooter>
            </TabView>
            <!--  Main Content: 선택된 탭의 SessionView  -->
            <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorAltBrush}">
                <ContentControl
                    x:Name="SessionHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <StackPanel
                    x:Name="NoSessionState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="34"
                        Foreground="{StaticResource TextFaint}"
                        Glyph="&#xE756;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource TextMuted}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="No active sessions" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextFaint}"
                        Text="Connect from the Home panel to open a session tab" />
                </StackPanel>
            </Grid>
        </Grid>
        <!--  ── Column 2: Right Panel ──  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" />
            <Border
                Grid.Row="1"
                Padding="12,8,12,8"
                VerticalAlignment="Stretch"
                Background="{StaticResource PanelBg}">
                <ContentControl
                    x:Name="RightPanel"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</Window>   