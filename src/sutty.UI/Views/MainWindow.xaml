<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="sutty.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="sutty"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Compact tabs living on the title-bar line (no add button)  -->
        <TabView
            x:Name="TitleTabs"
            Grid.Row="0"
            VerticalAlignment="Stretch"
            IsAddTabButtonVisible="False"
            SelectionChanged="TitleTabs_SelectionChanged"
            TabCloseRequested="TitleTabs_TabCloseRequested"
            TabWidthMode="SizeToContent">
            <!--  Logo pinned to the left of the tab strip  -->
            <TabView.TabStripHeader>
                <Image
                    Width="20"
                    Height="20"
                    Margin="14,0,12,0"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/sutty.altform-lightunplated_targetsize-48.png" />
            </TabView.TabStripHeader>
            <!--  Remaining space stays draggable as the title bar  -->
            <TabView.TabStripFooter>
                <Grid x:Name="CustomDragRegion" Background="Transparent" />
            </TabView.TabStripFooter>

            <TabViewItem Header="Tab 1" IsClosable="True">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Document" />
                </TabViewItem.IconSource>
            </TabViewItem>
            <TabViewItem Header="Tab 2" IsClosable="True">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Document" />
                </TabViewItem.IconSource>
            </TabViewItem>
            <TabViewItem Header="Tab 2" IsClosable="True">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Document" />
                </TabViewItem.IconSource>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!--  Left navigation + center content (icon-only rail, never expands)  -->
            <NavigationView
                x:Name="LeftNav"
                Grid.Column="0"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                PaneDisplayMode="LeftCompact"
                SelectionChanged="LeftNav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Home"
                        Icon="Home"
                        Tag="Home" />
                    <NavigationViewItem
                        Content="Documents"
                        Icon="Document"
                        Tag="Documents" />
                    <NavigationViewItem
                        Content="Settings"
                        Icon="More"
                        Tag="Settings" />
                </NavigationView.MenuItems>

                <!--  Options icon pinned to the bottom of the rail  -->
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        Content="Options"
                        Icon="Setting"
                        Tag="Options" />
                </NavigationView.FooterMenuItems>

                <!--  Center panel: content swapped when a nav icon is clicked  -->
                <Grid Background="{ThemeResource LayerFillColorAltBrush}">
                    <TextBlock
                        x:Name="ContentText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Home" />
                </Grid>
            </NavigationView>

            <!--  Right panel: fixed column pinned to the right border  -->
            <StackPanel
                Grid.Column="1"
                Padding="12"
                VerticalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Right" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
