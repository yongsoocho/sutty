<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="sutty.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="sutty"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--  루트에 다크 테마 고정: 기본 컨트롤(NavView, TabView, 다이얼로그)도 팔레트와 어울리게  -->
    <Grid RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="336" />
        </Grid.ColumnDefinitions>

        <!--  타이틀 스트립 배경 (시각용, 전체 폭)  -->
        <Border
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="40"
            VerticalAlignment="Top"
            Background="{StaticResource AppBg}" />

        <!--
            창 드래그 영역: 탭/버튼 같은 인터랙티브 컨트롤은 이 위에 그려지므로
            빈 곳 어디서든 드래그로 창을 옮길 수 있다. (SetTitleBar 대상)
        -->
        <Grid
            x:Name="TitleBarDragRegion"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent" />

        <!--  ── Column 0: Logo + Left Nav Rail ──  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#131C2E" />
                    <GradientStop Offset="1.0" Color="#0B0F17" />
                </LinearGradientBrush>
            </Grid.Background>

            <Image
                Grid.Row="0"
                Width="24"
                Height="24"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/sutty.altform-lightunplated_targetsize-48.png" />
            <NavigationView
                x:Name="LeftNav"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                ItemInvoked="LeftNav_ItemInvoked"
                PaneDisplayMode="LeftCompact"
                SelectionChanged="LeftNav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="Search" Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="Folder" Tag="Folder">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="More" Tag="More">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE712;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        Content="Setting"
                        Icon="Setting"
                        SelectsOnInvoked="False"
                        Tag="Setting" />
                </NavigationView.FooterMenuItems>
            </NavigationView>
        </Grid>

        <!--  ── Column 1: Tabs + Main Content ──  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                세션 탭: Connect 할 때마다 코드에서 TabViewItem이 추가된다.
                HorizontalAlignment=Left 로 탭 폭만큼만 차지 → 나머지는 드래그 영역.
            -->
            <TabView
                x:Name="TitleTabs"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                IsAddTabButtonVisible="False"
                SelectionChanged="TitleTabs_SelectionChanged"
                TabCloseRequested="TitleTabs_TabCloseRequested"
                TabWidthMode="SizeToContent" />

            <!--  Main Content: 선택된 탭의 SessionView  -->
            <Grid Grid.Row="1" Background="{StaticResource PanelBg}">
                <ContentControl
                    x:Name="SessionHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <StackPanel
                    x:Name="NoSessionState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="34"
                        Foreground="{StaticResource TextFaint}"
                        Glyph="&#xE756;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource TextMuted}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="No active sessions" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextFaint}"
                        Text="Connect from the Home panel to open a session tab" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ── Column 2: Right Panel ──  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                Padding="14,10,14,10"
                VerticalAlignment="Stretch"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1,0,0,0">
                <ContentControl
                    x:Name="RightPanel"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</Window>
