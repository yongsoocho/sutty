<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.TransfersDashboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:local="using:sutty.UI.Views"
    Loaded="Dashboard_Loaded"
    Unloaded="Dashboard_Unloaded">
        <Grid Padding="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"
                           Text="{x:Bind h:Loc.T('파일 전송', 'File transfers')}" />
                <TextBlock Foreground="{ThemeResource TextMuted}" FontSize="11.5" TextWrapping="Wrap"
                           Text="{x:Bind h:Loc.T('선택한 SSH의 원격 파일 또는 이 PC의 로컬 파일을 탐색합니다.', 'Browse remote files for the selected SSH connection or local files on this PC.')}" />
                <TextBlock x:Name="ActiveShellText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextPrimary}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="BrowserScopeText" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="BrowserError" Foreground="{ThemeResource StatusRed}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                <StackPanel x:Name="ExternalTerminalState" Spacing="6" Visibility="Collapsed">
                    <TextBlock Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                               Text="{x:Bind h:Loc.T('외부 터미널의 원격 SFTP·Tunnels는 연결되지 않았습니다. 아래에서는 이 PC의 파일을 사용할 수 있습니다.', 'Remote SFTP and Tunnels are not connected to this external terminal. The browser below remains available for this PC.')}" />
                    <Button HorizontalAlignment="Left" Click="ConnectSsh_Click"
                            Content="{x:Bind h:Loc.T('원격 파일용 SSH 연결…', 'Connect SSH for remote files…')}" />
                </StackPanel>
                <StackPanel x:Name="NoTargetState" Spacing="6" Visibility="Collapsed">
                    <TextBlock Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                               Text="{x:Bind h:Loc.T('열린 셸이 없어도 로컬 파일을 탐색할 수 있습니다. 원격 파일은 SSH 연결을 선택하세요.', 'Local files are available without an open shell. Select an SSH connection for remote files.')}" />
                    <Button HorizontalAlignment="Left" Click="ConnectSsh_Click"
                            Content="{x:Bind h:Loc.T('SSH 연결…', 'Connect SSH…')}" />
                </StackPanel>
            </StackPanel>

            <Border x:Name="BrowserCard" Grid.Row="1" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1"
                    Background="{ThemeResource CardBg}" CornerRadius="10">
                <ContentControl x:Name="BrowserHost"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>

            <Border Grid.Row="2" Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource CardBorder}"
                    BorderThickness="1" CornerRadius="10">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="12,12,12,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimary}"
                               Text="{x:Bind h:Loc.T('전송 큐', 'Transfer queue')}" />
                    <local:TransferCenterPanel x:Name="TransferQueue" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
</UserControl>
