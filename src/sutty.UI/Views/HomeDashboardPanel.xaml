<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.HomeDashboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="12" Spacing="12">
        <Border
            Padding="12"
            Background="{ThemeResource SidePanelBg}"
            BorderBrush="{ThemeResource CardBorder}"
            BorderThickness="1"
            CornerRadius="10">
            <local:HomePanel x:Name="QuickConnect" />
        </Border>
        <Border
            Padding="12"
            Background="{ThemeResource CardBg}"
            BorderBrush="{ThemeResource CardBorder}"
            BorderThickness="1"
            CornerRadius="10">
            <local:OneLineConnectionPanel x:Name="OneLineConnection" />
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
