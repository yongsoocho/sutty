<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.LocalBrowserPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:sutty.UI.Controls"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:vm="using:sutty.UI.ViewModels">
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Padding="0" Click="Back_Click"
                    AutomationProperties.Name="{x:Bind h:Loc.T('뒤로', 'Back')}">
                <FontIcon FontSize="12" Glyph="&#xE72B;" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Padding="0" Click="Forward_Click"
                    AutomationProperties.Name="{x:Bind h:Loc.T('앞으로', 'Forward')}">
                <FontIcon FontSize="12" Glyph="&#xE72A;" />
            </Button>
            <Button x:Name="ParentButton" Grid.Column="2" Padding="0" Click="Parent_Click"
                    AutomationProperties.Name="{x:Bind h:Loc.T('상위 폴더', 'Parent folder')}">
                <FontIcon FontSize="12" Glyph="&#xE74A;" />
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="3" FontFamily="Cascadia Mono, Consolas"
                     FontSize="11.5" KeyDown="PathBox_KeyDown"
                     AutomationProperties.Name="{x:Bind h:Loc.T('로컬 폴더 경로', 'Local folder path')}" />
            <Button Grid.Column="4" Padding="0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Bind h:Loc.T('새로 고침', 'Refresh')}">
                <FontIcon FontSize="12" Glyph="&#xE72C;" />
            </Button>
        </Grid>
        <controls:WrapPanel Grid.Row="1" Spacing="8">
            <Button Click="FollowShell_Click" Content="{x:Bind h:Loc.T('현재 셸 폴더', 'Current shell folder')}" />
            <Button Click="OpenExplorer_Click" Content="{x:Bind h:Loc.T('탐색기에서 열기', 'Open in Explorer')}" />
            <CheckBox x:Name="ShowHiddenToggle" MinWidth="0" Click="ShowHidden_Click"
                      Content="{x:Bind h:Loc.T('숨김 파일', 'Hidden files')}" />
        </controls:WrapPanel>
        <Grid Grid.Row="2">
            <ListView x:Name="FileList" ItemsSource="{x:Bind Browser.Items}"
                      SelectionMode="Extended" CanDragItems="True" CanReorderItems="False"
                      DragItemsStarting="FileList_DragItemsStarting" DoubleTapped="FileList_DoubleTapped"
                      KeyDown="FileList_KeyDown" AllowDrop="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{x:Bind h:Loc.T('현재 셸의 로컬 파일과 폴더', 'Local files and folders for the current shell')}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,5" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalFileItemViewModel">
                        <Grid ColumnSpacing="8" RowSpacing="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon FontSize="15" Glyph="&#xE8B7;" Foreground="{ThemeResource StatusAmber}"
                                      Visibility="{x:Bind IsDirectory}" AutomationProperties.Name="{x:Bind h:Loc.T('폴더', 'Folder')}" />
                            <FontIcon FontSize="14" Glyph="&#xE8A5;" Foreground="{ThemeResource AccentBlue}"
                                      Visibility="{x:Bind IsFile}" AutomationProperties.Name="{x:Bind h:Loc.T('파일', 'File')}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullPath}" />
                            <controls:WrapPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                <TextBlock FontSize="10" Foreground="{ThemeResource TextFaint}" Text="{x:Bind TypeText}" />
                                <TextBlock FontSize="10" Foreground="{ThemeResource TextFaint}" Text="{x:Bind SizeText}" />
                                <TextBlock FontSize="10" Foreground="{ThemeResource TextFaint}" Text="{x:Bind ModifiedText}" />
                            </controls:WrapPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing x:Name="LoadingRing" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextMuted}" Text="{x:Bind h:Loc.T('이 폴더가 비어 있습니다.', 'This folder is empty.')}" />
        </Grid>
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource StatusRed}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{ThemeResource TextMuted}"
                       Text="{x:Bind h:Loc.T('파일을 탐색기로 끌어 복사할 수 있습니다. 이 목록으로 파일을 넣으려면 탐색기를 이용하세요.', 'Drag files to Explorer to copy them. Use Explorer to copy files into this folder.')}" />
        </StackPanel>
    </Grid>
</UserControl>
