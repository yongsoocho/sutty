<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.OneLineConnectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:sutty.UI.Helpers">
    <StackPanel Margin="2,6" Spacing="10">
        <StackPanel Spacing="3">
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"
                Text="{x:Bind h:Loc.T('한 줄 연결', 'One-line connection')}" />
            <TextBlock FontSize="11" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                Text="{x:Bind h:Loc.T('ssh worker1 또는 multipass connect master를 로컬 터미널에서 바로 엽니다.', 'Open ssh worker1 or multipass connect master directly in a local terminal.')}" />
        </StackPanel>

        <Grid ColumnSpacing="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="CommandLauncherBox"
                MinHeight="36" Padding="10,5" CornerRadius="7" FontSize="12.5"
                Background="{ThemeResource InputBg}" BorderBrush="{ThemeResource InputBorder}"
                Foreground="{ThemeResource TextPrimary}"
                FontFamily="Cascadia Mono, Consolas" MaxLength="2048"
                AutomationProperties.Name="{x:Bind h:Loc.T('한 줄 연결 명령', 'One-line connection command')}"
                PlaceholderText="ssh worker1"
                KeyDown="CommandLauncherBox_KeyDown" TextChanged="CommandLauncherBox_TextChanged" />
            <Button x:Name="SaveCommandFavoriteButton" Grid.Column="1" Width="36" Height="36" Padding="0"
                AutomationProperties.Name="{x:Bind h:Loc.T('호스트 즐겨찾기에 저장', 'Save to host favorites')}"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('현재 명령을 호스트 즐겨찾기에 저장', 'Save this command to host favorites')}"
                Click="SaveCommandFavorite_Click">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE734;" FontSize="15" />
            </Button>
            <Button x:Name="CommandLauncherRunButton" Grid.Column="2" Height="36" MinWidth="64"
                AutomationProperties.Name="{x:Bind h:Loc.T('명령 연결 실행', 'Run connection command')}"
                Click="RunCommandLauncher_Click" FontWeight="SemiBold"
                Content="{x:Bind h:Loc.T('열기', 'Open')}" />
        </Grid>

        <TextBlock x:Name="CommandLauncherStatusText" AutomationProperties.LiveSetting="Assertive"
            FontSize="10.5" Foreground="{ThemeResource StatusRed}" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel x:Name="CommandHistorySection" Spacing="5" Visibility="Collapsed">
            <TextBlock CharacterSpacing="55" FontSize="10" FontWeight="SemiBold"
                Foreground="{ThemeResource TextFaint}" Text="{x:Bind h:Loc.T('최근 명령', 'RECENT COMMANDS')}" />
            <ScrollViewer MaxHeight="208" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CommandHistoryPanel" Spacing="4" />
            </ScrollViewer>
        </StackPanel>

        <TextBlock FontSize="10" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
            Text="{x:Bind h:Loc.T('비밀번호·토큰은 명령에 넣지 마세요. SSH는 기존 .ssh/config와 Agent를 사용합니다. 출력은 저장하지 않습니다.', 'Keep passwords and tokens out of commands. SSH uses your existing .ssh/config and Agent. Output is not stored.')}" />
    </StackPanel>
</UserControl>
