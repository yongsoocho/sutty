<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.FileTreePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="Files" />
            <Border
                Grid.Column="1"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentTint}"
                CornerRadius="10">
                <TextBlock
                    CharacterSpacing="40"
                    FontSize="10.5"
                    Foreground="{ThemeResource AccentTeal}"
                    Text="SFTP" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Button
                Padding="0"
                AutomationProperties.Name="{x:Bind h:Loc.T('상위 폴더', 'Parent folder')}"
                Background="{ThemeResource InputBg}"
                BorderBrush="{ThemeResource InputBorder}"
                Click="ParentPath_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('상위 폴더', 'Parent folder')}">
                <FontIcon FontSize="12" Glyph="&#xE74A;" />
            </Button>
            <TextBox
                x:Name="PathBox"
                Grid.Column="1"
                MinHeight="30"
                Padding="8,3"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="11.5"
                KeyDown="PathBox_KeyDown"
                PlaceholderText="/var/www" />
            <Button
                Grid.Column="2"
                Padding="0"
                AutomationProperties.Name="{x:Bind h:Loc.T('경로 열기', 'Open path')}"
                Background="{ThemeResource InputBg}"
                BorderBrush="{ThemeResource InputBorder}"
                Click="GoPath_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('경로 열기', 'Open path')}">
                <FontIcon FontSize="12" Glyph="&#xE72A;" />
            </Button>
            <Button
                Grid.Column="3"
                Padding="0"
                AutomationProperties.Name="{x:Bind h:Loc.T('새로 고침', 'Refresh')}"
                Background="{ThemeResource InputBg}"
                BorderBrush="{ThemeResource InputBorder}"
                Click="Refresh_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('새로 고침', 'Refresh')}">
                <FontIcon FontSize="12" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <TreeView
            x:Name="FileTree"
            Grid.Row="2"
            AllowDrop="True"
            CanDragItems="False"
            CanReorderItems="False"
            DragOver="Tree_DragOver"
            Drop="Tree_Drop"
            Expanding="FileTree_Expanding"
            ItemsSource="{x:Bind RootNodes}"
            SelectionMode="Single">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileNode">
                    <TreeViewItem
                        AllowDrop="True"
                        DoubleTapped="Node_DoubleTapped"
                        DragOver="Node_DragOver"
                        Drop="Node_Drop"
                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        ItemsSource="{x:Bind Children}"
                        MinHeight="27"
                        Padding="0">
                        <TreeViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="Download_Click"
                                    Icon="Download"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('다른 이름으로 다운로드…', 'Download / Save as…')}"
                                    Visibility="{x:Bind CanDownload}" />
                                <MenuFlyoutItem
                                    Click="NewFolder_Click"
                                    Icon="NewFolder"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('새 폴더…', 'New folder…')}"
                                    Visibility="{x:Bind IsDirectory}" />
                                <MenuFlyoutItem
                                    Click="Rename_Click"
                                    Icon="Rename"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('이름 바꾸기…', 'Rename…')}"
                                    Visibility="{x:Bind CanModify}" />
                                <MenuFlyoutItem
                                    Click="ChangePermissions_Click"
                                    Icon="Edit"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('권한 변경…', 'Change permissions…')}"
                                    Visibility="{x:Bind CanModify}" />
                                <MenuFlyoutItem
                                    Click="Delete_Click"
                                    Icon="Delete"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('삭제…', 'Delete…')}"
                                    Visibility="{x:Bind CanModify}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="OpenTerminalHere_Click"
                                    Icon="OpenFile"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('여기서 터미널 열기', 'Open in terminal')}" />
                                <MenuFlyoutItem
                                    Click="CopyPath_Click"
                                    Icon="Copy"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind h:Loc.T('경로 복사', 'Copy path')}" />
                            </MenuFlyout>
                        </TreeViewItem.ContextFlyout>
                        <StackPanel Margin="6,3" Orientation="Horizontal" Spacing="7">
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource AccentBlue}"
                                Glyph="&#xE8B7;"
                                Visibility="{x:Bind FolderClosedVisible, Mode=OneWay}" />
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource AccentTeal}"
                                Glyph="&#xE838;"
                                Visibility="{x:Bind FolderOpenVisible, Mode=OneWay}" />
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource TextMuted}"
                                Glyph="&#xE8A5;"
                                Visibility="{x:Bind IsFile}" />
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextPrimary}"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextFaint}"
                                Text="{x:Bind SizeText}" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="2"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource TextMuted}"
                Glyph="&#xE8CE;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('활성 세션 없음', 'No active session')}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('서버에 연결하면 파일 트리가 표시됩니다', 'Connect to a server to browse its files')}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            x:Name="SftpUnavailableState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            MaxWidth="240"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource StatusRed}"
                Glyph="&#xE783;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="{x:Bind h:Loc.T('SFTP 사용 불가', 'SFTP unavailable')}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('SSH 터미널은 계속 사용할 수 있습니다.', 'The SSH terminal is still available.')}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            x:Name="TransfersPanel"
            Grid.Row="3"
            MaxHeight="150"
            Padding="8"
            Background="{ThemeResource CardBg}"
            BorderBrush="{ThemeResource CardBorder}"
            BorderThickness="1"
            CornerRadius="7"
            Visibility="Collapsed">
            <StackPanel Spacing="5">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextMuted}"
                        Text="{x:Bind h:Loc.T('전송', 'TRANSFERS')}" />
                    <Button
                        x:Name="ResumeRestoredButton"
                        Grid.Column="1"
                        MinHeight="24"
                        Padding="7,2"
                        Click="ResumeRestoredTransfers_Click"
                        Content="{x:Bind h:Loc.T('복원 작업 재개', 'Resume restored')}"
                        FontSize="10"
                        Visibility="Collapsed" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind Transfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SftpTransferItemVm">
                                <Grid Margin="0,3" ColumnSpacing="7" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <FontIcon
                                        Grid.RowSpan="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTeal}"
                                        Glyph="{x:Bind DirectionGlyph}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="10.5"
                                        Foreground="{ThemeResource TextPrimary}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Grid.RowSpan="2"
                                        Padding="3"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PauseTransfer_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind h:Loc.T('전송 일시 정지', 'Pause transfer')}"
                                        Visibility="{x:Bind CanPause, Mode=OneWay}">
                                        <FontIcon FontSize="9" Glyph="&#xE769;" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Grid.RowSpan="2"
                                        Padding="3"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ResumePausedTransfer_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind h:Loc.T('전송 재개', 'Resume transfer')}"
                                        Visibility="{x:Bind CanResume, Mode=OneWay}">
                                        <FontIcon FontSize="9" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        Grid.Column="4"
                                        Grid.RowSpan="2"
                                        Padding="3"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CancelTransfer_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind h:Loc.T('전송 취소', 'Cancel transfer')}"
                                        Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                        <FontIcon FontSize="9" Glyph="&#xE711;" />
                                    </Button>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar
                                            Width="56"
                                            VerticalAlignment="Center"
                                            Maximum="1"
                                            Value="{x:Bind Progress, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            MinWidth="38"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTeal}"
                                            Text="{x:Bind ProgressText, Mode=OneWay}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="9.5"
                                            Foreground="{ThemeResource TextFaint}"
                                            Text="{x:Bind DetailText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Margin="4,0"
            FontSize="10.5"
            Foreground="{ThemeResource StatusRed}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
