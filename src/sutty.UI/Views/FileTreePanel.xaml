<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.FileTreePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  헤더  -->
        <StackPanel Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="Medium"
                Foreground="{StaticResource TextPrimary}"
                Text="Files" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Foreground="{StaticResource TextMuted}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  파일 트리 (FileZilla 스타일)  -->
        <Border
            Grid.Row="1"
            Padding="6"
            Style="{StaticResource Card}">
            <Grid>
                <TreeView
                    x:Name="FileTree"
                    AllowDrop="False"
                    CanDragItems="False"
                    CanReorderItems="False"
                    ItemsSource="{x:Bind RootNodes}"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileNode">
                            <TreeViewItem IsExpanded="{x:Bind IsExpandedInitially}" ItemsSource="{x:Bind Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{x:Bind GlyphBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource TextFaint}"
                                        Text="{x:Bind SizeText}" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
