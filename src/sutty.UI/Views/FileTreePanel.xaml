<?xml version="1.0" encoding="utf-8" ?>
<!--  파일 트리만 심플하게. 탐색기에서 파일을 끌어다 놓으면 그 위치로 업로드.  -->
<UserControl
    x:Class="sutty.UI.Views.FileTreePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="Files" />
            <Border
                Grid.Column="1"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentTint}"
                CornerRadius="10">
                <TextBlock
                    CharacterSpacing="40"
                    FontSize="10.5"
                    Foreground="{ThemeResource AccentTeal}"
                    Text="SFTP" />
            </Border>
        </Grid>

        <TreeView
            x:Name="FileTree"
            Grid.Row="1"
            AllowDrop="True"
            CanDragItems="False"
            CanReorderItems="False"
            DragOver="Tree_DragOver"
            Drop="Tree_Drop"
            Expanding="FileTree_Expanding"
            ItemsSource="{x:Bind RootNodes}"
            SelectionMode="Single">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileNode">
                    <TreeViewItem
                        AllowDrop="True"
                        DragOver="Node_DragOver"
                        Drop="Node_Drop"
                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        ItemsSource="{x:Bind Children}"
                        MinHeight="26"
                        Padding="0">
                        <Grid MinHeight="24">
                            <Border
                                Background="{ThemeResource AccentTint}"
                                CornerRadius="5"
                                Opacity="0.45"
                                Visibility="{x:Bind IsUploading, Mode=OneWay}" />
                            <StackPanel
                                Margin="6,3"
                                Orientation="Horizontal"
                                Spacing="7">
                            <!--  폴더 아이콘: 닫힘=E8B7, 펼침=열린 폴더 E838 + 청록색으로 구별  -->
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource AccentBlue}"
                                Glyph="&#xE8B7;"
                                Visibility="{x:Bind FolderClosedVisible, Mode=OneWay}" />
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource AccentTeal}"
                                Glyph="&#xE838;"
                                Visibility="{x:Bind FolderOpenVisible, Mode=OneWay}" />
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource TextMuted}"
                                Glyph="&#xE8A5;"
                                Visibility="{x:Bind IsFile}" />
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextPrimary}"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextFaint}"
                                Text="{x:Bind SizeText}" />

                            <!--  업로드 중일 때만: 진행 바 + % + 취소(X)  -->
                            <ProgressBar
                                Width="56"
                                VerticalAlignment="Center"
                                Maximum="1"
                                Visibility="{x:Bind IsUploading, Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource AccentTeal}"
                                Text="{x:Bind ProgressText, Mode=OneWay}"
                                Visibility="{x:Bind IsUploading, Mode=OneWay}" />
                            <Button
                                Padding="3"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CancelUpload_Click"
                                ToolTipService.ToolTip="Cancel upload"
                                Visibility="{x:Bind IsUploading, Mode=OneWay}">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{ThemeResource TextMuted}"
                                    Glyph="&#xE711;" />
                            </Button>
                            </StackPanel>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False" />

        <!--  세션이 없을 때  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource TextMuted}"
                Glyph="&#xE8CE;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('활성 세션 없음', 'No active session')}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('서버에 연결하면 파일 트리가 표시됩니다', 'Connect to a server to browse its files')}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  오류가 있을 때만 아래에 잠깐 표시  -->
        <StackPanel
            x:Name="SftpUnavailableState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            MaxWidth="240"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource StatusRed}"
                Glyph="&#xE783;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="{x:Bind h:Loc.T('SFTP 사용 불가', 'SFTP unavailable')}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('SSH 터미널은 계속 사용할 수 있습니다.', 'The SSH terminal is still available.')}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="4,0"
            FontSize="10.5"
            Foreground="{StaticResource StatusRed}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
