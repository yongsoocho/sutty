<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.FileTreePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  헤더  -->
        <StackPanel Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="Medium"
                Foreground="{StaticResource TextPrimary}"
                Text="Files" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Foreground="{StaticResource TextMuted}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  파일 트리: 탐색기에서 파일을 끌어다 놓으면 그 위치로 업로드  -->
        <Border
            Grid.Row="1"
            Padding="6"
            Style="{StaticResource Card}">
            <Grid>
                <TreeView
                    x:Name="FileTree"
                    AllowDrop="True"
                    CanDragItems="False"
                    CanReorderItems="False"
                    DragOver="Tree_DragOver"
                    Drop="Tree_Drop"
                    Expanding="FileTree_Expanding"
                    ItemsSource="{x:Bind RootNodes}"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileNode">
                            <TreeViewItem
                                AllowDrop="True"
                                DragOver="Node_DragOver"
                                Drop="Node_Drop"
                                HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                ItemsSource="{x:Bind Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{x:Bind GlyphBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource TextFaint}"
                                        Text="{x:Bind SizeText}" />

                                    <!--  업로드 중일 때만: 진행 바 + % + 취소(X)  -->
                                    <ProgressBar
                                        Width="64"
                                        VerticalAlignment="Center"
                                        Maximum="1"
                                        Visibility="{x:Bind IsUploading, Mode=OneWay}"
                                        Value="{x:Bind Progress, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource AccentBlue}"
                                        Text="{x:Bind ProgressText, Mode=OneWay}"
                                        Visibility="{x:Bind IsUploading, Mode=OneWay}" />
                                    <Button
                                        Padding="3"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CancelUpload_Click"
                                        ToolTipService.ToolTip="Cancel upload"
                                        Visibility="{x:Bind IsUploading, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{StaticResource TextMuted}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
