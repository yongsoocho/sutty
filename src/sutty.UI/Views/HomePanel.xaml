<UserControl
    x:Class="sutty.UI.Views.HomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,0,0,5" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="55" />
            <Setter Property="Foreground" Value="{ThemeResource TextFaint}" />
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{ThemeResource InputBg}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        </Style>
        <Style x:Key="FormPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{ThemeResource InputBg}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        </Style>
        <Style x:Key="AuthButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,6" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimary}"
                        Text="{x:Bind h:Loc.T('새 연결', 'New connection')}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextMuted}"
                        Text="{x:Bind h:Loc.T('SSH와 SFTP를 하나의 작업 공간에서 시작합니다.', 'Start SSH and SFTP in one workspace.')}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('주소', 'ADDRESS')}" />
                    <TextBox
                        x:Name="HostBox"
                        AutomationProperties.Name="{x:Bind h:Loc.T('서버 주소', 'Server address')}"
                        FontFamily="Cascadia Mono, Consolas"
                        PlaceholderText="hostname or IP"
                        Style="{StaticResource FormInput}" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('사용자', 'USERNAME')}" />
                        <TextBox
                            x:Name="UsernameBox"
                            AutomationProperties.Name="{x:Bind h:Loc.T('사용자 이름', 'User name')}"
                            FontFamily="Cascadia Mono, Consolas"
                            PlaceholderText="root"
                            Style="{StaticResource FormInput}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('포트', 'PORT')}" />
                        <TextBox
                            x:Name="PortBox"
                            AutomationProperties.Name="{x:Bind h:Loc.T('SSH 포트', 'SSH port')}"
                            BeforeTextChanging="PortBox_BeforeTextChanging"
                            FontFamily="Cascadia Mono, Consolas"
                            InputScope="Number"
                            MaxLength="5"
                            Style="{StaticResource FormInput}"
                            Text="22" />
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('표시 이름', 'DISPLAY NAME')}" />
                    <TextBox
                        x:Name="DisplayNameBox"
                        AutomationProperties.Name="{x:Bind h:Loc.T('표시 이름', 'Display name')}"
                        PlaceholderText="Production API"
                        Style="{StaticResource FormInput}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('인증', 'AUTHENTICATION')}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AuthPasswordBtn"
                            Click="AuthButton_Click"
                            Content="{x:Bind h:Loc.T('비밀번호', 'Password')}"
                            Style="{StaticResource AuthButton}"
                            Tag="0" />
                        <Button
                            x:Name="AuthKeyBtn"
                            Grid.Column="1"
                            Click="AuthButton_Click"
                            Content="{x:Bind h:Loc.T('개인 키', 'Private key')}"
                            Style="{StaticResource AuthButton}"
                            Tag="1" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PasswordPanel" Margin="0,-6,0,0">
                    <PasswordBox
                        x:Name="PasswordBox"
                        AutomationProperties.Name="{x:Bind h:Loc.T('비밀번호', 'Password')}"
                        PlaceholderText="{x:Bind h:Loc.T('비밀번호', 'Password')}"
                        Style="{StaticResource FormPassword}" />
                </StackPanel>

                <StackPanel x:Name="KeyPanel" Margin="0,-6,0,0" Spacing="10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('개인 키 파일', 'PRIVATE KEY FILE')}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Name="KeyPathBox"
                                Height="36"
                                MinHeight="36"
                                Padding="10,5"
                                AutomationProperties.Name="{x:Bind h:Loc.T('개인 키 파일 경로', 'Private-key file path')}"
                                CornerRadius="7"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12.5"
                                GotFocus="KeyPathBox_GotFocus"
                                PlaceholderText="~/.ssh/id_ed25519"
                                SuggestionChosen="KeyPathBox_SuggestionChosen"
                                TextChanged="KeyPathBox_TextChanged"
                                UpdateTextOnSelect="True" />
                            <Button
                                Grid.Column="1"
                                Height="36"
                                Background="{ThemeResource PillBg}"
                                BorderBrush="{ThemeResource CardBorder}"
                                Click="BrowseKey_Click"
                                Content="{x:Bind h:Loc.T('찾기', 'Browse')}"
                                CornerRadius="7"
                                Foreground="{ThemeResource TextPrimary}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('키 암호 (선택)', 'KEY PASSPHRASE (OPTIONAL)')}" />
                        <PasswordBox
                            x:Name="PassphraseBox"
                            AutomationProperties.Name="{x:Bind h:Loc.T('개인 키 암호', 'Private-key passphrase')}"
                            PlaceholderText="{x:Bind h:Loc.T('키 암호', 'Passphrase')}"
                            Style="{StaticResource FormPassword}" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Padding="10"
                    Background="{ThemeResource CardBg}"
                    BorderBrush="{ThemeResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="9">
                        <CheckBox
                            x:Name="SaveProfileCheck"
                            Checked="SaveProfileCheck_Changed"
                            Content="{x:Bind h:Loc.T('이 연결을 저장된 호스트로 보관', 'Save this connection as a host')}"
                            Foreground="{ThemeResource TextPrimary}"
                            Unchecked="SaveProfileCheck_Changed" />
                        <CheckBox
                            x:Name="RememberCredentialCheck"
                            Content="{x:Bind h:Loc.T('자격 증명을 이 Windows 사용자에게 암호화하여 저장', 'Encrypt and save the credential for this Windows user')}"
                            Foreground="{ThemeResource TextMuted}"
                            IsEnabled="False" />

                        <StackPanel x:Name="ProfileOptionsPanel" Spacing="9" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('그룹', 'GROUP')}" />
                                    <TextBox x:Name="GroupBox" MaxLength="64" Style="{StaticResource FormInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('환경', 'ENVIRONMENT')}" />
                                    <ComboBox x:Name="EnvironmentCombo" Height="36" SelectedIndex="0">
                                        <ComboBoxItem Content="{x:Bind h:Loc.T('미분류', 'Unclassified')}" Tag="Unclassified" />
                                        <ComboBoxItem Content="{x:Bind h:Loc.T('개발', 'Development')}" Tag="Development" />
                                        <ComboBoxItem Content="{x:Bind h:Loc.T('스테이징', 'Staging')}" Tag="Staging" />
                                        <ComboBoxItem Content="{x:Bind h:Loc.T('운영', 'Production')}" Tag="Production" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <CheckBox
                                x:Name="FavoriteCheck"
                                Content="{x:Bind h:Loc.T('즐겨찾기에 표시', 'Show in favorites')}"
                                Foreground="{ThemeResource TextMuted}" />
                        </StackPanel>

                        <TextBlock
                            FontSize="10.5"
                            Foreground="{ThemeResource TextFaint}"
                            Text="{x:Bind h:Loc.T('자격 증명 저장은 선택 사항입니다. 비밀정보는 설정 파일이나 호스트 데이터베이스에 기록되지 않습니다.', 'Credential storage is optional. Secrets are never written to settings or the host database.')}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('태그', 'TAGS')}" />
                    <ItemsControl ItemsSource="{x:Bind Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,7,5"
                                    Padding="9,3"
                                    Background="{ThemeResource PillBg}"
                                    BorderBrush="{ThemeResource CardBorder}"
                                    BorderThickness="1"
                                    Click="RemoveTag_Click"
                                    CornerRadius="10"
                                    Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontSize="11" Foreground="{ThemeResource AccentTeal}" Text="{Binding}" />
                                        <FontIcon FontSize="9" Foreground="{ThemeResource TextMuted}" Glyph="&#xE711;" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        x:Name="AddTagButton"
                        Padding="9,3"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardBorder}"
                        BorderThickness="1"
                        Click="AddTag_Click"
                        Content="{x:Bind h:Loc.T('+ 태그', '+ tag')}"
                        CornerRadius="10"
                        FontSize="11"
                        Foreground="{ThemeResource TextMuted}" />
                </StackPanel>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextMuted}"
                            Text="{x:Bind h:Loc.T('연결 옵션', 'Connection options')}" />
                    </Expander.Header>
                    <StackPanel Padding="0,8,0,2" Spacing="10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('연결 경로', 'CONNECTION ROUTE')}" />
                            <ComboBox
                                x:Name="RouteCombo"
                                Height="36"
                                SelectedIndex="0"
                                SelectionChanged="RouteCombo_SelectionChanged">
                                <ComboBoxItem Content="Direct" Tag="Direct" />
                                <ComboBoxItem Content="HTTP CONNECT" Tag="HttpConnect" />
                                <ComboBoxItem Content="SOCKS4" Tag="Socks4" />
                                <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="ProxyPanel" Spacing="8" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('프록시 주소', 'PROXY HOST')}" />
                                    <TextBox x:Name="ProxyHostBox" Style="{StaticResource FormInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('포트', 'PORT')}" />
                                    <TextBox
                                        x:Name="ProxyPortBox"
                                        BeforeTextChanging="PortBox_BeforeTextChanging"
                                        InputScope="Number"
                                        MaxLength="5"
                                        Style="{StaticResource FormInput}" />
                                </StackPanel>
                            </Grid>
                            <TextBox
                                x:Name="ProxyUsernameBox"
                                Header="{x:Bind h:Loc.T('프록시 사용자 (선택)', 'Proxy user (optional)')}"
                                Style="{StaticResource FormInput}" />
                            <PasswordBox
                                x:Name="ProxyPasswordBox"
                                Header="{x:Bind h:Loc.T('프록시 비밀번호 (선택)', 'Proxy password (optional)')}"
                                Style="{StaticResource FormPassword}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="EnterpriseRouteCheck"
                            Content="{x:Bind h:Loc.T('기업 모드: 직접 연결 및 자동 우회 금지', 'Enterprise mode: block direct connection and fallback')}"
                            Foreground="{ThemeResource TextMuted}" />
                        <TextBlock Style="{StaticResource FormLabel}" Text="{x:Bind h:Loc.T('연결 유지 간격 (초)', 'KEEP-ALIVE (SECONDS)')}" />
                        <NumberBox
                            x:Name="KeepAliveBox"
                            Height="36"
                            Maximum="3600"
                            Minimum="0"
                            SpinButtonPlacementMode="Hidden"
                            Value="30" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock
                x:Name="SettingsSaveStatusText"
                AutomationProperties.LiveSetting="Assertive"
                FontSize="10.5"
                Foreground="{ThemeResource StatusRed}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <Button
                x:Name="ConnectButton"
                Height="40"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource AccentGradient}"
                BorderThickness="0"
                Click="Connect_Click"
                Content="{x:Bind h:Loc.T('연결', 'Connect')}"
                CornerRadius="8"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#FFFFFF" />
        </StackPanel>
    </Grid>
</UserControl>
