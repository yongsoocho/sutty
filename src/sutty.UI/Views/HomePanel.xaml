<UserControl
    x:Class="sutty.UI.Views.HomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <!--  팔레트/공용 스타일은 Styles/Palette.xaml (App 리소스)에서 온다  -->
    <Border Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <!--  헤더  -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Medium"
                        Foreground="{StaticResource TextPrimary}"
                        Text="Connect" />
                    <ComboBox
                        x:Name="VaultCombo"
                        MinWidth="140"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource AccentBlue}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Team Vault" />
                        <ComboBoxItem Content="Personal Vault" />
                        <ComboBoxItem Content="Local only" />
                    </ComboBox>
                </StackPanel>

                <!--  Address  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Address" />
                        <TextBox
                            x:Name="HostBox"
                            VerticalAlignment="Center"
                            PlaceholderText="hostname or IP (e.g. 10.0.0.15)"
                            Style="{StaticResource DarkInput}" />
                    </StackPanel>
                </Border>

                <!--  General  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="General" />
                        <TextBox
                            x:Name="DisplayNameBox"
                            PlaceholderText="Display name (e.g. Admin Devops Team)"
                            Style="{StaticResource DarkInput}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource TagPill}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="admin" />
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{StaticResource TextMuted}"
                                        Glyph="&#xE711;" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TagPill}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="personal" />
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{StaticResource TextMuted}"
                                        Glyph="&#xE711;" />
                                </StackPanel>
                            </Border>
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="{StaticResource PillBg}"
                                BorderBrush="{StaticResource CardBorder}"
                                Content="+"
                                CornerRadius="14"
                                Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Connection  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Connection" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="SSH on" />
                            <NumberBox
                                x:Name="PortBox"
                                Width="120"
                                CornerRadius="8"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="22" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextMuted}"
                                Text="port" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Username" />
                            <Grid>
                                <TextBox
                                    x:Name="UsernameBox"
                                    Padding="38,8,12,8"
                                    PlaceholderText="username"
                                    Style="{StaticResource DarkInput}" />
                                <FontIcon
                                    Margin="13,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Foreground="{StaticResource TextMuted}"
                                    Glyph="&#xE77B;"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Authentication" />
                            <ComboBox
                                x:Name="AuthCombo"
                                MinHeight="40"
                                HorizontalAlignment="Stretch"
                                CornerRadius="8"
                                SelectedIndex="0"
                                SelectionChanged="AuthCombo_SelectionChanged">
                                <ComboBoxItem Content="Password" />
                                <ComboBoxItem Content="Public key" />
                                <ComboBoxItem Content="SSH agent" />
                                <ComboBoxItem Content="Keyboard-interactive" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="PasswordPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                PlaceholderText="Password"
                                Style="{StaticResource DarkPassword}" />
                        </StackPanel>

                        <StackPanel
                            x:Name="KeyPanel"
                            Spacing="10"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Private key" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="KeyPathBox"
                                        Grid.Column="0"
                                        PlaceholderText="~/.ssh/id_ed25519"
                                        Style="{StaticResource DarkInput}" />
                                    <Button
                                        Grid.Column="1"
                                        MinHeight="40"
                                        Background="{StaticResource PillBg}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        Click="BrowseKey_Click"
                                        Content="Browse"
                                        CornerRadius="8"
                                        Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Key passphrase (optional)" />
                                <PasswordBox
                                    x:Name="PassphraseBox"
                                    PlaceholderText="Passphrase"
                                    Style="{StaticResource DarkPassword}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            x:Name="AgentPanel"
                            Padding="12"
                            Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TextMuted}"
                                Text="Uses keys loaded in your running SSH agent (ssh-agent / Pageant). No key file or password needed."
                                TextWrapping="Wrap" />
                        </Border>

                        <Border
                            x:Name="KbiPanel"
                            Padding="12"
                            Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TextMuted}"
                                Text="The server will prompt for responses (e.g. one-time codes / 2FA) at connect time."
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  고급 옵션  -->
                <Expander
                    x:Name="AdvancedExpander"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}"
                    CornerRadius="12"
                    Header="Advanced">
                    <StackPanel Padding="0,8,0,4" Spacing="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump host / bastion (optional)" />
                            <TextBox
                                x:Name="JumpHostBox"
                                PlaceholderText="user@bastion:22"
                                Style="{StaticResource DarkInput}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Keep-alive interval (seconds)" />
                            <NumberBox
                                x:Name="KeepAliveBox"
                                CornerRadius="8"
                                Maximum="3600"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                Value="30" />
                        </StackPanel>
                        <CheckBox
                            x:Name="CompressionCheck"
                            Content="Enable compression"
                            Foreground="{StaticResource TextPrimary}" />
                        <CheckBox
                            x:Name="X11Check"
                            Content="X11 forwarding"
                            Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </Expander>

                <!--  Connect — 액센트 블루 (화면에서 가장 눈에 띄는 버튼)  -->
                <Button
                    x:Name="ConnectButton"
                    Height="48"
                    Margin="0,4,0,24"
                    HorizontalAlignment="Stretch"
                    Click="Connect_Click"
                    Content="Connect"
                    CornerRadius="10"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#3E7BE8" />
                            <GradientStop Offset="1.0" Color="#2B5FC7" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.BorderBrush>
                        <SolidColorBrush Color="#5B9CFF" />
                    </Button.BorderBrush>
                    <Button.BorderThickness>1</Button.BorderThickness>
                    <Button.Resources>
                        <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#4C89F2" />
                            <GradientStop Offset="1.0" Color="#3568D0" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#2E5FB8" />
                            <GradientStop Offset="1.0" Color="#224A9C" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D6E4FF" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7DB0FF" />
                    </Button.Resources>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
