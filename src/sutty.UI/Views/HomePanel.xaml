<UserControl
    x:Class="sutty.UI.Views.HomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ===== 팔레트 (navy brand #121E31 ~ #0B111E) =====  -->
        <SolidColorBrush x:Key="PanelBg" Color="#0D1520" />
        <SolidColorBrush x:Key="CardBg" Color="#121E31" />
        <SolidColorBrush x:Key="CardBorder" Color="#1E2E48" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E1E8F2" />
        <SolidColorBrush x:Key="TextMuted" Color="#5A6E8A" />
        <SolidColorBrush x:Key="AccentBlue" Color="#4E8FEF" />
        <SolidColorBrush x:Key="AccentTeal" Color="#38B2BD" />

        <!--  ===== 입력 컨트롤 다크 오버라이드 =====  -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0A1019" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E1724" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0E1724" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1E2E48" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2A3E5C" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4E8FEF" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#E1E8F2" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E1E8F2" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E1E8F2" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#3E5470" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#3E5470" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#3E5470" />

        <!--  ===== ComboBox 다크 오버라이드 =====  -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#0A1019" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0E1724" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0E1724" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1E2E48" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#E1E8F2" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#121E31" />

        <!--  ===== 스타일 =====  -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="DarkPassword" TargetType="PasswordBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="Background" Value="#0E1926" />
            <Setter Property="BorderBrush" Value="#1E2E48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Resources>

    <!--  ===== 루트 =====  -->
    <Border Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <!--  헤더  -->
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="Host Details" />
                    <ComboBox
                        x:Name="VaultCombo"
                        MinWidth="140"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource AccentBlue}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Team Vault" />
                        <ComboBoxItem Content="Personal Vault" />
                        <ComboBoxItem Content="Local only" />
                    </ComboBox>
                </StackPanel>

                <!--  Address  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Address" />
                        <TextBox
                            x:Name="HostBox"
                            VerticalAlignment="Center"
                            PlaceholderText="hostname or IP (e.g. 10.0.0.15)"
                            Style="{StaticResource DarkInput}" />
                    </StackPanel>
                </Border>

                <!--  General  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="General" />
                        <TextBox
                            x:Name="DisplayNameBox"
                            PlaceholderText="Display name (e.g. Admin Devops Team)"
                            Style="{StaticResource DarkInput}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource TagPill}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="admin" />
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{StaticResource TextMuted}"
                                        Glyph="&#xE711;" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TagPill}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="personal" />
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{StaticResource TextMuted}"
                                        Glyph="&#xE711;" />
                                </StackPanel>
                            </Border>
                            <Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="#0E1926"
                                BorderBrush="#1E2E48"
                                Content="+"
                                CornerRadius="14"
                                Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Connection  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Connection" />

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="SSH on" />
                            <NumberBox
                                x:Name="PortBox"
                                Width="120"
                                CornerRadius="8"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="22" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextMuted}"
                                Text="port" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Username" />
                            <Grid>
                                <TextBox
                                    x:Name="UsernameBox"
                                    Padding="38,8,12,8"
                                    PlaceholderText="username"
                                    Style="{StaticResource DarkInput}" />
                                <FontIcon
                                    Margin="13,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Foreground="{StaticResource TextMuted}"
                                    Glyph="&#xE77B;"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Authentication" />
                            <ComboBox
                                x:Name="AuthCombo"
                                MinHeight="40"
                                HorizontalAlignment="Stretch"
                                CornerRadius="8"
                                SelectedIndex="0"
                                SelectionChanged="AuthCombo_SelectionChanged">
                                <ComboBoxItem Content="Password" />
                                <ComboBoxItem Content="Public key" />
                                <ComboBoxItem Content="SSH agent" />
                                <ComboBoxItem Content="Keyboard-interactive" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="PasswordPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                PlaceholderText="Password"
                                Style="{StaticResource DarkPassword}" />
                        </StackPanel>

                        <StackPanel
                            x:Name="KeyPanel"
                            Spacing="10"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Private key" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="KeyPathBox"
                                        Grid.Column="0"
                                        PlaceholderText="~/.ssh/id_ed25519"
                                        Style="{StaticResource DarkInput}" />
                                    <Button
                                        Grid.Column="1"
                                        MinHeight="40"
                                        Background="#0E1926"
                                        BorderBrush="#1E2E48"
                                        Click="BrowseKey_Click"
                                        Content="Browse"
                                        CornerRadius="8"
                                        Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Key passphrase (optional)" />
                                <PasswordBox
                                    x:Name="PassphraseBox"
                                    PlaceholderText="Passphrase"
                                    Style="{StaticResource DarkPassword}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            x:Name="AgentPanel"
                            Padding="12"
                            Background="#0A1019"
                            BorderBrush="#1E2E48"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TextMuted}"
                                Text="Uses keys loaded in your running SSH agent (ssh-agent / Pageant). No key file or password needed."
                                TextWrapping="Wrap" />
                        </Border>

                        <Border
                            x:Name="KbiPanel"
                            Padding="12"
                            Background="#0A1019"
                            BorderBrush="#1E2E48"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TextMuted}"
                                Text="The server will prompt for responses (e.g. one-time codes / 2FA) at connect time."
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  고급 옵션  -->
                <Expander
                    x:Name="AdvancedExpander"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}"
                    CornerRadius="12"
                    Header="Advanced">
                    <StackPanel Padding="0,8,0,4" Spacing="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Jump host / bastion (optional)" />
                            <TextBox
                                x:Name="JumpHostBox"
                                PlaceholderText="user@bastion:22"
                                Style="{StaticResource DarkInput}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Keep-alive interval (seconds)" />
                            <NumberBox
                                x:Name="KeepAliveBox"
                                CornerRadius="8"
                                Maximum="3600"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                Value="30" />
                        </StackPanel>
                        <CheckBox
                            x:Name="CompressionCheck"
                            Content="Enable compression"
                            Foreground="{StaticResource TextPrimary}" />
                        <CheckBox
                            x:Name="X11Check"
                            Content="X11 forwarding"
                            Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </Expander>

                <!--  Connect — 브랜드 네이비 + 블루 글로우  -->
                <Button
                    x:Name="ConnectButton"
                    Height="48"
                    Margin="0,4,0,24"
                    HorizontalAlignment="Stretch"
                    Click="Connect_Click"
                    Content="Connect"
                    CornerRadius="10"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#E1E8F2">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#1A3050" />
                            <GradientStop Offset="1.0" Color="#121E31" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.BorderBrush>
                        <SolidColorBrush Color="#2A4468" />
                    </Button.BorderBrush>
                    <Button.BorderThickness>1</Button.BorderThickness>
                    <Button.Resources>
                        <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#22395C" />
                            <GradientStop Offset="1.0" Color="#1A2B42" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#0E1826" />
                            <GradientStop Offset="1.0" Color="#0B111E" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B0BDD0" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3B5A8A" />
                    </Button.Resources>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
