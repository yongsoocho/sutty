<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="SettingsPanel_Unloaded">

    <UserControl.Resources>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextMuted}" />
            <Setter Property="Margin" Value="1,0,0,5" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBg}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="SettingsNumber" TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
        <Style x:Key="SettingsDangerButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource CardBg}" />
            <Setter Property="Foreground" Value="{ThemeResource StatusRed}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StatusRed}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{ThemeResource StatusRed}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsDangerConfirmationButton" TargetType="Button"
            BasedOn="{StaticResource SettingsDangerButton}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{ThemeResource SidePanelBg}">
        <!--  타이틀바 오버레이 영역(40px)을 피해서 시작  -->
        <NavigationView
            x:Name="SettingsNav"
            Margin="0"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="196"
            ExpandedModeThresholdWidth="1000"
            CompactModeThresholdWidth="640"
            PaneDisplayMode="Auto"
            SelectionChanged="SettingsNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind h:Loc.T('모양', 'Appearance')}" FontSize="12.5" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind h:Loc.T('터미널', 'Terminal')}" FontSize="12.5" Tag="Terminal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind h:Loc.T('연결', 'Connection')}" FontSize="12.5" Tag="Connection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind h:Loc.T('보안', 'Security')}" FontSize="12.5" Tag="Security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind h:Loc.T('문제 해결', 'Troubleshooting')}" FontSize="12.5" Tag="Troubleshooting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind h:Loc.T('창', 'Window')}" FontSize="12.5" Tag="Window">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE740;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind h:Loc.T('정보', 'About')}" FontSize="12.5" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1040" Padding="20,12,20,24">

                    <!--  ── Appearance: 언어/테마 (선택 즉시 적용/저장) ──  -->
                    <StackPanel x:Name="AppearancePane" Spacing="10">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{x:Bind h:Loc.T('모양 / 언어', 'Appearance')}" />
                        <TextBlock
                            Margin="0,-4,0,0"
                            FontSize="10.5"
                            Foreground="{ThemeResource TextMuted}"
                            Text="{x:Bind h:Loc.T('선택하면 즉시 적용되고 저장됩니다.', 'Choices apply and save immediately.')}" />

                        <!--  언어  -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="LANGUAGE / 언어" />
                                <ComboBox
                                    x:Name="LanguageCombo"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="7"
                                    FontSize="12.5"
                                    MinHeight="36"
                                    SelectionChanged="LanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="한국어" />
                                    <ComboBoxItem Content="English" />
                                </ComboBox>
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('현재 열린 화면에 즉시 반영됩니다.', 'Applies immediately to the currently open UI.')}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <ToggleSwitch
                                x:Name="DarkModeToggle"
                                FontSize="12.5"
                                Header="Dark / Light"
                                OffContent="Light"
                                OnContent="Dark"
                                Toggled="DarkModeToggle_Toggled" />
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                            <ComboBox
                                x:Name="ThemeRadios"
                                HorizontalAlignment="Stretch"
                                IsTextSearchEnabled="True"
                                MaxDropDownHeight="420"
                                FontSize="12.5"
                                Header="{x:Bind h:Loc.T('앱 테마', 'Application theme')}"
                                SelectionChanged="ThemeRadios_SelectionChanged" />
                            <Border Height="6" Background="{ThemeResource AccentGradient}" CornerRadius="3" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextMuted}"
                                Text="{x:Bind h:Loc.T('모든 테마에서 그라데이션 강조를 유지합니다. 터미널 색상은 터미널 설정에서 별도로 선택할 수도 있습니다.', 'Every theme keeps gradient accents. You can also choose a separate terminal palette in Terminal settings.')}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── Terminal ──  -->
                    <StackPanel
                        x:Name="TerminalPane"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Terminal" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource SettingsLabel}"
                                        Text="{x:Bind h:Loc.T('터미널 글꼴', 'TERMINAL FONT')}" />
                                    <AutoSuggestBox
                                        x:Name="FontFamilyBox"
                                        CornerRadius="7"
                                        FontSize="12.5"
                                        IsSuggestionListOpen="False"
                                        LostFocus="FontFamilyBox_LostFocus"
                                        MinHeight="36"
                                        PlaceholderText="Cascadia Mono"
                                        QuerySubmitted="FontFamilyBox_QuerySubmitted"
                                        SuggestionChosen="FontFamilyBox_SuggestionChosen"
                                        TextChanged="FontFamilyBox_TextChanged"
                                        UpdateTextOnSelect="True" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="SIZE" />
                                    <NumberBox
                                        x:Name="FontSizeBox"
                                        Maximum="32"
                                        Minimum="8"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource SettingsLabel}"
                                        Text="{x:Bind h:Loc.T('터미널 색상 테마', 'TERMINAL COLOR THEME')}" />
                                    <ComboBox
                                        x:Name="TerminalThemeCombo"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="7"
                                        FontSize="12.5"
                                        MinHeight="36"
                                        SelectionChanged="TerminalAppearanceCombo_SelectionChanged" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Style="{StaticResource SettingsLabel}"
                                            Text="{x:Bind h:Loc.T('커서 모양', 'CURSOR STYLE')}" />
                                        <ComboBox
                                            x:Name="CursorStyleCombo"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="7"
                                            FontSize="12.5"
                                            MinHeight="36"
                                            SelectionChanged="TerminalAppearanceCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Style="{StaticResource SettingsLabel}"
                                            Text="{x:Bind h:Loc.T('스크롤백 줄 수', 'SCROLLBACK LINES')}" />
                                        <NumberBox
                                            x:Name="ScrollbackBox"
                                            Maximum="50000"
                                            Minimum="100"
                                            SpinButtonPlacementMode="Hidden"
                                            ValueChanged="NumberBox_ValueChanged"
                                            Style="{StaticResource SettingsNumber}" />
                                    </StackPanel>
                                </Grid>
                                <ToggleSwitch
                                    x:Name="CursorBlinkToggle"
                                    Header="{x:Bind h:Loc.T('터미널 커서 깜박임', 'Blinking terminal cursor')}"
                                    Toggled="TerminalAppearanceToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="ScreenReaderToggle"
                                    Header="{x:Bind h:Loc.T('화면 읽기 프로그램 모드', 'Screen reader mode')}"
                                    Toggled="TerminalAppearanceToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="LoadShellProfileToggle"
                                    Header="{x:Bind h:Loc.T('로컬 PowerShell 프로필 불러오기', 'Load local PowerShell profile')}"
                                    OffContent="{x:Bind h:Loc.T('새 로컬 탭에 미적용', 'Disabled for new local tabs')}"
                                    OnContent="{x:Bind h:Loc.T('새 로컬 탭에 적용', 'Enabled for new local tabs')}"
                                    Toggled="TerminalAppearanceToggle_Toggled" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('가운데 화면은 항상 셸입니다. + 메뉴에서 PowerShell 또는 CMD를 열고, 명령 도구는 옆 패널에서 사용하세요.', 'The center always shows the shell. Open PowerShell or CMD from the + menu and use command tools in the side panel.')}" />
                                <ToggleSwitch
                                    x:Name="AutoCloseDisconnectedTabsToggle"
                                    Header="{x:Bind h:Loc.T('셸 종료·연결 해제 시 해당 탭 자동 닫기', 'Automatically close the tab when its shell exits or disconnects')}"
                                    OnContent="{x:Bind h:Loc.T('자동 닫기 (기본)', 'Close automatically (default)')}"
                                    OffContent="{x:Bind h:Loc.T('종료된 탭 유지', 'Keep ended tabs open')}"
                                    Toggled="AutoCloseDisconnectedTabsToggle_Toggled" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('SSH 로그아웃, 연결 종료, 로컬·외부 프로그램 종료에 적용됩니다. 처음 연결에 실패한 탭은 유지합니다. 전송이나 편집본이 있으면 복구 위치를 안내하고 닫기 전에 확인합니다. Sutty 앱은 계속 열려 있습니다.', 'Applies to SSH logout, disconnects, and local or external program exits. Initial connection failures stay open. Transfers or editor copies require confirmation with their recovery location before closing. Sutty stays open.')}" />
                                <ToggleSwitch
                                    x:Name="StructuredHighlightToggle"
                                    Header="{x:Bind h:Loc.T('JSON / YAML 문법 강조', 'JSON / YAML syntax highlighting')}"
                                    Toggled="TerminalFeatureToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="SeverityHighlightToggle"
                                    Header="{x:Bind h:Loc.T('위험·경고 키워드 강조', 'Critical and warning highlighting')}"
                                    Toggled="TerminalFeatureToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="CommandSuggestionToggle"
                                    Header="{x:Bind h:Loc.T('명령 자동 제안', 'Command suggestions')}"
                                    Toggled="TerminalFeatureToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="SuggestionTabToggle"
                                    Header="{x:Bind h:Loc.T('Tab으로 제안 적용', 'Accept suggestions with Tab')}"
                                    Toggled="TerminalFeatureToggle_Toggled" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── Connection ──  -->
                    <StackPanel
                        x:Name="ConnectionPane"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="Connection defaults" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="DEFAULT SSH PORT" />
                                    <NumberBox
                                        x:Name="DefaultPortBox"
                                        Maximum="65535"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="KEEP-ALIVE INTERVAL (SECONDS)" />
                                    <NumberBox
                                        x:Name="KeepAliveBox"
                                        Maximum="3600"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Style="{StaticResource SettingsLabel}"
                                    Text="{x:Bind h:Loc.T('호스트 프로필 가져오기', 'HOST PROFILE IMPORT')}" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('비밀번호 없이 호스트·키 경로·route·tunnel만 가져옵니다. 중복 호스트는 건너뜁니다.', 'Imports hosts, key paths, routes, and tunnels without passwords. Duplicate hosts are skipped.')}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="ImportOpenSshButton"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportOpenSsh_Click"
                                    Content="{x:Bind h:Loc.T('OpenSSH config 가져오기…', 'Import OpenSSH config…')}" />
                                <Button
                                    x:Name="ImportWindowsSessionsButton"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportWindowsSessions_Click"
                                    Content="{x:Bind h:Loc.T('Windows 저장 세션 가져오기', 'Import Windows saved sessions')}" />
                                <Button
                                    x:Name="ImportIniProfilesButton"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportIniProfiles_Click"
                                    Content="{x:Bind h:Loc.T('레거시 INI 프로필 폴더 가져오기…', 'Import legacy INI profile folder…')}" />
                                <Button
                                    x:Name="ImportSftpSiteManagerButton"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportSftpSiteManager_Click"
                                    Content="{x:Bind h:Loc.T('SFTP Site Manager XML 가져오기…', 'Import SFTP Site Manager XML…')}" />
                                <TextBlock
                                    x:Name="ImportStatusText"
                                    AutomationProperties.LiveSetting="Polite"
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="SFTP TRANSFER RETRY" />
                                <ToggleSwitch
                                    x:Name="SftpRetryToggle"
                                    Header="{x:Bind h:Loc.T('일시적인 SFTP 실패 자동 재시도', 'Retry transient SFTP failures')}"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="SftpRetryToggle_Toggled" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="{x:Bind h:Loc.T('재시도 횟수 (기본 3회)', 'Retry count (default: 3)')}" />
                                    <NumberBox
                                        x:Name="SftpRetryCountBox"
                                        Maximum="10"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="{x:Bind h:Loc.T('전송 완료 검증', 'TRANSFER VERIFICATION')}" />
                                    <ComboBox
                                        x:Name="SftpVerificationCombo"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="SftpVerificationCombo_SelectionChanged">
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('빠름 · 최종 크기만 확인', 'Fast · final size only')}"
                                            Tag="SizeOnly" />
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('안전 · 크기 + SHA-256 (기본)', 'Safe · size + SHA-256 (default)')}"
                                            Tag="Sha256" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="{x:Bind h:Loc.T('같은 이름 파일 처리', 'FILE CONFLICT POLICY')}" />
                                    <ComboBox
                                        x:Name="SftpConflictPolicyCombo"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="SftpConflictPolicyCombo_SelectionChanged">
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('매번 확인 (기본)', 'Ask every time (default)')}"
                                            Tag="Ask" />
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('안전하게 덮어쓰기', 'Safely overwrite')}"
                                            Tag="Overwrite" />
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('기존 파일 건너뛰기', 'Skip existing files')}"
                                            Tag="Skip" />
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('새 이름으로 저장', 'Keep both with a new name')}"
                                            Tag="Rename" />
                                        <ComboBoxItem
                                            Content="{x:Bind h:Loc.T('새 파일일 때만 교체', 'Replace only when source is newer')}"
                                            Tag="NewerOnly" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('SHA-256 모드는 전송 후 원격 파일을 다시 읽으므로 대용량 파일에서 더 오래 걸립니다.', 'SHA-256 mode rereads the remote file after transfer and takes longer for large files.')}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SettingsHeading}" Text="{x:Bind h:Loc.T('원격 파일 편집기', 'Remote file editor')}" />
                                <TextBox x:Name="EditorExecutableBox" Header="{x:Bind h:Loc.T('편집기 .exe 절대 경로 (비워 두면 메모장)', 'Editor .exe absolute path (empty uses Notepad)')}"
                                         TextChanged="EditorSettings_TextChanged" AutomationProperties.Name="{x:Bind h:Loc.T('외부 편집기 실행 파일', 'External editor executable')}" />
                                <Button Content="{x:Bind h:Loc.T('편집기 선택', 'Choose editor')}" Click="SelectExternalEditor_Click" />
                                <TextBox x:Name="EditorArgumentsBox" Header="{x:Bind h:Loc.T('인수 · {file}은 편집본 경로로 바뀝니다', 'Arguments · {file} is replaced with the working-copy path')}"
                                         TextChanged="EditorSettings_TextChanged" AutomationProperties.Name="{x:Bind h:Loc.T('편집기 인수', 'Editor arguments')}" />
                                <TextBlock Text="{x:Bind h:Loc.T('텍스트 파일은 8 MiB까지 편집합니다. 저장 후 서버 반영은 기본적으로 직접 확인합니다. 편집본과 복구용 사본은 이 PC에 남으므로 작업이 끝나면 보관 폴더에서 삭제하세요.', 'Edit text files up to 8 MiB. Uploading changes requires confirmation by default. Working and recovery copies stay on this PC; remove them from the recovery folder when finished.')}"
                                           TextWrapping="Wrap" FontSize="12" />
                                <Button Content="{x:Bind h:Loc.T('편집본 보관 폴더 열기', 'Open working-copy recovery folder')}" Click="OpenEditRecovery_Click" />
                            </StackPanel>
                        </Border>

                        <!--  접속 히스토리 (append-only 로그) 설정  -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="HISTORY" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="{x:Bind h:Loc.T('보관 일수 (지난 기록은 자동 삭제)', 'Retention days (older logs auto-deleted)')}" />
                                    <NumberBox
                                        x:Name="HistoryDaysBox"
                                        Maximum="365"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="{x:Bind h:Loc.T('상단에 고정할 자주 접속한 호스트 수', 'Frequently used hosts shown at top')}" />
                                    <NumberBox
                                        x:Name="HistoryTopHostCountBox"
                                        Maximum="16"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── Security / Known Hosts ──  -->
                    <StackPanel
                        x:Name="SecurityPane"
                        Visibility="Collapsed">
                        <Expander Header="{x:Bind h:Loc.T('고급 · Known Hosts 관리', 'Advanced · Known Hosts management')}">
                            <local:KnownHostsManagerPanel x:Name="KnownHostsPanel" />
                        </Expander>
                    </StackPanel>

                    <!--  ── Troubleshooting: raw diagnostics remain explicitly advanced. ──  -->
                    <StackPanel
                        x:Name="SupportPane"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{x:Bind h:Loc.T('문제 해결', 'Troubleshooting')}" />
                        <Expander
                            x:Name="RawLogsExpander"
                            Header="{x:Bind h:Loc.T('고급 · 원시 진단 로그', 'Advanced · Raw diagnostic logs')}">
                            <local:ConnectionLogPanel
                                x:Name="ConnectionLogsPanel"
                                Height="560" />
                        </Expander>
                        <Expander Header="{x:Bind h:Loc.T('고급 · 지원 번들 내보내기', 'Advanced · Export support bundle')}">
                            <local:SupportBundlePanel x:Name="SupportBundlePanel" />
                        </Expander>
                    </StackPanel>

                    <!--  ── Window ──  -->
                    <StackPanel
                        x:Name="WindowPane"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{x:Bind h:Loc.T('창과 작업공간', 'Window and workspace')}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="{x:Bind h:Loc.T('작업공간 복원', 'WORKSPACE RESTORE')}" />
                                <ToggleSwitch
                                    x:Name="RestoreWorkspaceToggle"
                                    Header="{x:Bind h:Loc.T('종료할 때 열린 탭 기억', 'Remember tabs open at exit')}"
                                    OffContent="{x:Bind h:Loc.T('기억 안 함', 'Do not remember')}"
                                    OnContent="{x:Bind h:Loc.T('최대 16개 기억', 'Remember up to 16')}"
                                    Toggled="WorkspaceToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="ConfirmWorkspaceRestoreToggle"
                                    Header="{x:Bind h:Loc.T('SSH 탭 재연결 전에 확인', 'Confirm before reconnecting SSH tabs')}"
                                    OffContent="{x:Bind h:Loc.T('자동 복원', 'Restore automatically')}"
                                    OnContent="{x:Bind h:Loc.T('시작할 때 확인', 'Ask at startup')}"
                                    Toggled="WorkspaceToggle_Toggled" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('로컬 탭과 저장 Host ID만 기록합니다. 비밀번호·키 암호·명령은 저장하거나 재실행하지 않습니다.', 'Only local tabs and Saved Host IDs are recorded. Passwords, key passphrases, and commands are never stored or replayed.')}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('입력값과 드래그 변경 모두 자동 저장되며 즉시 적용됩니다.', 'Typed and dragged size changes save automatically and apply immediately.')}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="MAIN WINDOW (WIDTH × HEIGHT)" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        x:Name="MainWidthBox"
                                        Grid.Column="0"
                                        Maximum="7680"
                                        Minimum="640"
                                        PlaceholderText="width"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                    <NumberBox
                                        x:Name="MainHeightBox"
                                        Grid.Column="1"
                                        Maximum="4320"
                                        Minimum="480"
                                        PlaceholderText="height"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NumberBox_ValueChanged"
                                        Style="{StaticResource SettingsNumber}" />
                                </Grid>
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="RIGHT PANEL WIDTH (PX, 300~800)" />
                                <NumberBox
                                    x:Name="PanelWidthBox"
                                    Maximum="800"
                                    Minimum="300"
                                    PlaceholderText="width"
                                    SpinButtonPlacementMode="Hidden"
                                    ValueChanged="NumberBox_ValueChanged"
                                    Style="{StaticResource SettingsNumber}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── About / Alpha release identity ──  -->
                    <StackPanel
                        x:Name="AboutPane"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsHeading}" Text="{x:Bind h:Loc.T('Sutty 정보', 'About Sutty')}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="64"
                                        Height="64"
                                        Background="{ThemeResource AccentTint}"
                                        CornerRadius="14">
                                        <Image
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="ms-appx:///Assets/sutty.targetsize-48.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            x:Name="ReleaseVersionText"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimary}" />
                                        <Border
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            Background="{ThemeResource AccentTint}"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="9.5"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource AccentTeal}"
                                                Text="ALPHA" />
                                        </Border>
                                        <TextBlock
                                            x:Name="ReleaseBuildText"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextMuted}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('Windows 11 24H2 이상 · x64 / ARM64 · 로컬 우선 SSH/SFTP 작업공간', 'Windows 11 24H2 or later · x64 / ARM64 · Local-first SSH/SFTP workspace')}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="9">
                                <TextBlock Style="{StaticResource SettingsLabel}" Text="ALPHA NOTICE / 알림" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource StatusAmber}"
                                    Text="{x:Bind h:Loc.T('현재 Alpha ZIP은 코드 서명되지 않은 시험 배포물입니다.', 'The current Alpha ZIP is an unsigned evaluation build.')}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind h:Loc.T('공식 Release의 SHA-256을 확인하고 개발·테스트 환경에서 먼저 사용하세요. 실서버 호환성 및 서명 설치 인수는 아직 진행 중입니다.', 'Verify SHA-256 from the official Release and evaluate it in development or test environments first. Live-server compatibility and signed-install acceptance are still pending.')}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton
                                        Padding="0"
                                        Content="{x:Bind h:Loc.T('Alpha 다운로드', 'Download Alpha')}"
                                        NavigateUri="https://github.com/yongsoocho/sutty/releases" />
                                    <HyperlinkButton
                                        Padding="0"
                                        Content="{x:Bind h:Loc.T('보안 정책', 'Security policy')}"
                                        NavigateUri="https://github.com/yongsoocho/sutty/security/policy" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}" BorderBrush="{ThemeResource StatusRed}">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                    Foreground="{ThemeResource StatusRed}"
                                    Text="{x:Bind h:Loc.T('초기화', 'Reset')}" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                                    Text="{x:Bind h:Loc.T('초기화할 대상을 선택하세요. 각 작업은 실행 전에 예 / 아니오로 다시 확인합니다.', 'Choose what to reset. Each action asks Yes / No before making changes.')}" />
                                <Button x:Name="ResetSettingsButton" Style="{StaticResource SettingsDangerButton}"
                                    Click="ResetSettings_Click"
                                    Content="{x:Bind h:Loc.T('설정 초기화', 'Reset settings')}" />
                                <TextBlock FontSize="10.5" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                                    Text="{x:Bind h:Loc.T('테마·언어·터미널·연결 기본값·창 설정을 기본값으로 되돌립니다.', 'Restore defaults for themes, language, terminal, connections, and window preferences.')}" />
                                <Button x:Name="ResetDatabaseButton" Style="{StaticResource SettingsDangerButton}"
                                    Click="ResetDatabase_Click"
                                    Content="{x:Bind h:Loc.T('SQLite 데이터 초기화', 'Reset SQLite data')}" />
                                <TextBlock FontSize="10.5" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                                    Text="{x:Bind h:Loc.T('저장 Host·접속 기록·명령 템플릿·연결 즐겨찾기와 최근 기록을 삭제합니다.', 'Delete saved hosts, connection history, command templates, launcher favorites, and launcher history.')}" />
                                <TextBlock x:Name="ResetStatusText" FontSize="11" TextWrapping="Wrap"
                                    AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <NavigationView.PaneFooter>
                <!--  자동 저장 debounce가 남아 있을 때 즉시 flush하는 보조 동작  -->
                <StackPanel
                    Margin="12,0,12,12"
                    Orientation="Vertical"
                    Spacing="6">
                    <Button
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource AccentGradient}"
                        BorderThickness="0"
                        Click="Save_Click"
                        Content="{x:Bind h:Loc.T('지금 저장', 'Save now')}"
                        CornerRadius="8"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentForeground}">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentGradientHover" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentGradient" />
                        </Button.Resources>
                    </Button>
                    <TextBlock
                        x:Name="SavedText"
                        HorizontalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="10.5"
                        Foreground="{ThemeResource StatusGreen}"
                        Text="{x:Bind h:Loc.T('변경 사항은 자동 저장됩니다.', 'Changes save automatically.')}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Visible" />
                </StackPanel>
            </NavigationView.PaneFooter>
        </NavigationView>
    </Border>
</UserControl>
