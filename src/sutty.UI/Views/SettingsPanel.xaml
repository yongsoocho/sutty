<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Border Background="{StaticResource PanelBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="440"
                Padding="24,44,24,24"
                Spacing="16">

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimary}"
                    Text="Settings" />

                <!--  Terminal  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Terminal" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Font family" />
                            <TextBox x:Name="FontFamilyBox" Style="{StaticResource DarkInput}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Font size" />
                            <NumberBox
                                x:Name="FontSizeBox"
                                CornerRadius="8"
                                Maximum="32"
                                Minimum="8"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Connection defaults  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Connection defaults" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Default SSH port" />
                            <NumberBox
                                x:Name="DefaultPortBox"
                                CornerRadius="8"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Keep-alive interval (seconds)" />
                            <NumberBox
                                x:Name="KeepAliveBox"
                                CornerRadius="8"
                                Maximum="3600"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Behavior  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Behavior" />
                        <ToggleSwitch
                            x:Name="ConfirmCloseToggle"
                            Foreground="{StaticResource TextMuted}"
                            Header="Confirm before closing a connected tab" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        MinWidth="100"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}"
                        Click="Save_Click"
                        Content="Save"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}" />
                    <TextBlock
                        x:Name="SavedText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource StatusGreen}"
                        Text="Saved"
                        Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
