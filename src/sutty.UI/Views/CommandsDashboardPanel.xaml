<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.CommandsDashboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="16" Background="{ThemeResource AppBg}">
            <StackPanel Spacing="3">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind h:Loc.T('명령 라이브러리', 'Command library')}" />
                <TextBlock
                    Foreground="{ThemeResource TextMuted}"
                    TextWrapping="Wrap"
                    Text="{x:Bind h:Loc.T('저장 명령을 선택한 SSH 세션에서 실행합니다.', 'Run saved commands in the selected SSH session.')}" />
            </StackPanel>
        </Grid>
        <local:CommandPanel
            x:Name="CommandLibrary"
            Grid.Row="1"
            Margin="12,8,12,12" />
    </Grid>
</UserControl>
