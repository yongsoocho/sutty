<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.CommandsDashboardPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18,24,14" Background="{ThemeResource AppBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind h:Loc.T('명령 라이브러리', 'Command library')}" />
                <TextBlock
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('저장 명령을 선택한 SSH 세션에서 실행합니다.', 'Run saved commands in the selected SSH session.')}" />
            </StackPanel>
            <Button
                x:Name="PowerToolsButton"
                Grid.Column="1"
                Padding="14,7"
                AutomationProperties.Name="{x:Bind h:Loc.T('여러 세션 명령 도구 열기', 'Open multi-session command tools')}"
                Click="PowerTools_Click"
                Content="{x:Bind h:Loc.T('여러 세션 도구', 'Multi-session tools')}"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('명시적으로 선택한 세션에만 실행', 'Run only on explicitly selected sessions')}" />
        </Grid>
        <local:CommandPanel
            x:Name="CommandLibrary"
            Grid.Row="1"
            Margin="24,16,24,24" />
    </Grid>
</UserControl>
