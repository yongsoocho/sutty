<UserControl
    x:Class="sutty.UI.Views.HostListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:sutty.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    mc:Ignorable="d">

    <Border Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,12" Spacing="12">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="{x:Bind h:Loc.T('호스트', 'Hosts')}" />

                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinHeight="36"
                    CornerRadius="7"
                    FontSize="12.5"
                    PlaceholderText="{x:Bind h:Loc.T('호스트 검색...', 'Search hosts...')}"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <Button Content="{x:Bind h:Loc.T('호스트·명령 공유 / 가져오기', 'Share / import hosts and commands')}"
                        Click="ShareDefinitions_Click" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind h:Loc.T('JSON 공유 및 가져오기', 'Share and import JSON definitions')}" />

                <TextBlock
                    x:Name="TopHeader"
                    CharacterSpacing="80"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('즐겨찾기', 'FAVORITES')}" />
                <ItemsRepeater x:Name="TopRepeater" ItemsSource="{x:Bind TopHosts}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="6"
                            MinItemWidth="136"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostInfoModel">
                            <controls:HostCard Host="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock
                    x:Name="SavedHeader"
                    Margin="0,4,0,0"
                    CharacterSpacing="80"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('저장 호스트', 'SAVED HOSTS')}" />
                <ItemsRepeater x:Name="SavedRepeater" ItemsSource="{x:Bind SavedHosts}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="6"
                            MinItemWidth="136"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostInfoModel">
                            <controls:HostCard Host="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock
                    x:Name="RecentHeader"
                    Margin="0,4,0,0"
                    CharacterSpacing="80"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('최근 접속', 'RECENT')}" />
                <ItemsRepeater x:Name="HostRepeater" ItemsSource="{x:Bind FilteredHosts}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="6"
                            MinItemWidth="136"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostInfoModel">
                            <controls:HostCard Host="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock
                    x:Name="EmptyState"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('접속 기록이 없습니다', 'No hosts found')}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StoreErrorState"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource StatusRed}"
                    Text="{x:Bind h:Loc.T('호스트 저장소를 열 수 없습니다', 'Host storage is unavailable')}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
