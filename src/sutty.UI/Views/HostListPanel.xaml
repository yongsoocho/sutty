<UserControl
    x:Class="sutty.UI.Views.HostListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:sutty.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    mc:Ignorable="d">

    <Border Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,12" Spacing="12">

                <!--  헤더  -->
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="History" />

                <!--  검색  -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinHeight="36"
                    CornerRadius="7"
                    FontSize="12.5"
                    PlaceholderText="{x:Bind h:Loc.T('호스트 검색...', 'Search hosts...')}"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <!--  사용자가 직접 고정한 호스트  -->
                <TextBlock
                    x:Name="PinnedHeader"
                    CharacterSpacing="80"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMuted}"
                    Text="PINNED" />
                <ItemsRepeater x:Name="PinnedRepeater" ItemsSource="{x:Bind PinnedHosts}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="6"
                            MinItemWidth="136"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostInfoModel">
                            <controls:HostCard Host="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  최근 접속 로그 (append-only, 최신순)  -->
                <TextBlock
                    x:Name="RecentHeader"
                    Margin="0,4,0,0"
                    CharacterSpacing="80"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMuted}"
                    Text="RECENT" />
                <ItemsRepeater x:Name="HostRepeater" ItemsSource="{x:Bind FilteredHosts}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HostInfoModel">
                            <controls:HostCard Host="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  빈 상태  -->
                <TextBlock
                    x:Name="EmptyState"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('접속 기록이 없습니다', 'No hosts found')}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
