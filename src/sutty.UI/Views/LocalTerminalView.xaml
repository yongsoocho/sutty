<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.LocalTerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:sutty.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    PreviewKeyDown="LocalTerminalView_PreviewKeyDown"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource TerminalBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="14,7"
            BorderBrush="{ThemeResource Divider}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Foreground="{ThemeResource AccentTeal}"
                    Glyph="&#xE756;" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimary}"
                        Text="PowerShell" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontSize="9.5"
                        Foreground="{ThemeResource TextMuted}" />
                </StackPanel>

                <Border
                    x:Name="StatusPill"
                    Grid.Column="2"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="StatusPillText"
                        FontSize="10.5"
                        FontWeight="SemiBold" />
                </Border>

                <TextBlock
                    x:Name="TerminalStatusText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="10.5"
                    Foreground="{ThemeResource TextMuted}"
                    Text="CONPTY 120&#x00D7;40" />
            </Grid>
        </Border>

        <controls:TerminalRendererControl
            x:Name="TerminalSurface"
            Grid.Row="1"
            AutomationProperties.Name="Local PowerShell terminal"
            Loaded="TerminalSurface_Loaded" />
    </Grid>
</UserControl>
