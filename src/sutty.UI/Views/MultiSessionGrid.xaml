<?xml version="1.0" encoding="utf-8" ?>
<!--
    Multi command: 열린 세션들을 4×4 그리드로 보여주고 브로드캐스트 대상을 체크로 고른다.
    그리드는 화면 크기에 맞춰 가로·세로를 꽉 채우고(반응형),
    각 셀에는 마지막 브로드캐스트 결과가 작은 글씨로 표시된다.
-->
<UserControl
    x:Class="sutty.UI.Views.MultiSessionGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="Multi command" />
            <Border
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentTint}"
                CornerRadius="10">
                <TextBlock
                    x:Name="CountText"
                    FontSize="11"
                    Foreground="{ThemeResource AccentTeal}" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('· 체크된 세션에만 명령이 전송됩니다', '· commands go only to checked sessions')}" />
        </StackPanel>

        <!--  4×4 반응형 그리드 (SizeChanged에서 셀 크기를 1/4씩 계산)  -->
        <ItemsRepeater
            Grid.Row="1"
            ItemsSource="{x:Bind Slots}"
            SizeChanged="Cells_SizeChanged">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    x:Name="GridLayout"
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="4"
                    MinColumnSpacing="8"
                    MinItemHeight="104"
                    MinItemWidth="150"
                    MinRowSpacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:MultiSlotVm">
                    <Grid>
                        <Border
                            BorderBrush="{ThemeResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind IsEmpty}">
                            <!--  빈 슬롯  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextMuted}"
                                Text="empty" />
                        </Border>

                            <!--  세션 슬롯  -->
                        <Border
                            Padding="10"
                            Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind HasSession}">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    Content="{x:Bind Title}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimary}"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind HostText}"
                                    TextTrimming="CharacterEllipsis" />

                                <!--  마지막 브로드캐스트 결과 (작은 글씨, 넘치면 잘림)  -->
                                <TextBlock
                                    Grid.Row="2"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind LastOutput, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind StateBrush}" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{ThemeResource TextMuted}"
                                        Text="{x:Bind StateText}" />
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextMuted}"
                                        Text="{x:Bind ResultText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Grid>
</UserControl>
