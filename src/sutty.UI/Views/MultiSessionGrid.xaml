<?xml version="1.0" encoding="utf-8" ?>
<!--
    Multi command: 열린 세션들을 3×3 그리드에 표시한다.
    현재는 첫 9개 탭만 선택할 수 있으며 각 셀의 출력은 스크롤해서 읽을 수 있다.
-->
<UserControl
    x:Class="sutty.UI.Views.MultiSessionGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:sutty.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WrapPanel Spacing="10">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="{x:Bind h:Loc.T('다중 명령', 'Multi command')}" />
            <Border
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentTint}"
                CornerRadius="10">
                <TextBlock
                    x:Name="CountText"
                    FontSize="11"
                    Foreground="{ThemeResource AccentTeal}" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextMuted}"
                TextWrapping="Wrap"
                Text="{x:Bind h:Loc.T('· 연결된 Sutty SSH만 선택 · 터미널 상태와 별도 실행', '· connected Sutty SSH only · execution is separate from terminal state')}" />
        </controls:WrapPanel>

        <StackPanel Grid.Row="1" Spacing="6">
        <controls:WrapPanel Spacing="8">
            <Button
                x:Name="SelectAllButton"
                Padding="10,6"
                Click="SelectAll_Click"
                Content="{x:Bind h:Loc.T('SSH 전체 선택', 'Select all SSH')}"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('표시된 카드 중 연결된 Sutty SSH만 선택합니다', 'Select connected Sutty SSH among the visible cards')}" />
            <Button
                x:Name="ClearSelectionButton"
                Padding="10,6"
                Click="ClearSelection_Click"
                Content="{x:Bind h:Loc.T('전체 해제', 'Clear all')}"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('숨겨진 카드를 포함한 모든 선택을 해제합니다', 'Clear every selection, including hidden cards')}" />
            <StackPanel x:Name="PaginationControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <Button
                x:Name="PreviousPageButton"
                Padding="10,6"
                Click="PreviousPage_Click"
                AutomationProperties.Name="{x:Bind h:Loc.T('이전 세션 페이지', 'Previous session page')}"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('이전 페이지', 'Previous page')}">
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>
            <TextBlock
                x:Name="PageText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextMuted}" />
            <Button
                x:Name="NextPageButton"
                Padding="10,6"
                Click="NextPage_Click"
                AutomationProperties.Name="{x:Bind h:Loc.T('다음 세션 페이지', 'Next session page')}"
                ToolTipService.ToolTip="{x:Bind h:Loc.T('다음 페이지', 'Next page')}">
                <FontIcon Glyph="&#xE76C;" FontSize="12" />
            </Button>
            </StackPanel>
        </controls:WrapPanel>
        <TextBlock x:Name="SelectionNoticeText" FontSize="11" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="CellsScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
        <ItemsRepeater
            x:Name="CellsRepeater"
            Width="586"
            Height="646"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ItemsSource="{x:Bind Slots}">
            <ItemsRepeater.Layout>
                <controls:MultiSessionFixedGridLayout />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:MultiSlotVm">
                    <Grid>
                        <Border
                            BorderBrush="{ThemeResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind IsEmpty}">
                            <!--  빈 슬롯  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextMuted}"
                                Text="{x:Bind h:Loc.T('비어 있음', 'empty')}" />
                        </Border>

                        <!--  세션 슬롯  -->
                        <Border
                            Padding="10"
                            Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind HasSession}">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimary}"
                                    IsEnabled="{x:Bind CanBroadcast, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind SelectionHelp, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Click="SessionSelection_Click"
                                    IsChecked="{x:Bind IsSelected, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" />
                                </CheckBox>
                                <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind HostText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind HostText, Mode=OneWay}" />
                                <TextBlock FontSize="10" Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind ExecutionModeText, Mode=OneWay}" TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{x:Bind SelectionHelp, Mode=OneWay}" />
                                </StackPanel>

                                <!--  마지막 브로드캐스트 결과: 긴 출력도 스크롤해서 읽는다.  -->
                                <ScrollViewer
                                    Grid.Row="2"
                                    MinHeight="24"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextMuted}"
                                        Text="{x:Bind LastOutput, Mode=OneWay}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>

                                <controls:WrapPanel
                                    Grid.Row="3"
                                    Spacing="6">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind StateBrush, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{ThemeResource TextMuted}"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind StateText, Mode=OneWay}" />
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextMuted}"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind ResultText, Mode=OneWay}" />
                                </controls:WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
