<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="sutty.UI.Views.ConnectionLogPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    Loaded="ConnectionLogPanel_Loaded"
    Unloaded="ConnectionLogPanel_Unloaded"
    mc:Ignorable="d">

    <Grid Padding="14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="148" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon
                FontSize="18"
                Foreground="{ThemeResource AccentTeal}"
                Glyph="&#xE9D9;" />
            <StackPanel>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="{x:Bind h:Loc.T('연결 로그', 'Connection logs')}" />
                <TextBlock
                    FontSize="10.5"
                    Foreground="{ThemeResource TextFaint}"
                    Text="{x:Bind h:Loc.T('현재 실행 중 수집 · 인증 비밀값 마스킹', 'Current run · authentication secrets redacted')}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <Border
                Padding="10"
                Background="{ThemeResource CardBg}"
                BorderBrush="{ThemeResource StatusAmber}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource StatusAmber}"
                        Glyph="&#xE7BA;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimary}"
                            Text="{x:Bind h:Loc.T('원시 로그 개인정보 안내', 'Raw log privacy notice')}" />
                        <TextBlock
                            FontSize="10.5"
                            Foreground="{ThemeResource TextMuted}"
                            Text="{x:Bind h:Loc.T('상세 원시 로그에는 호스트 이름, 사용자 이름, 파일 경로, 호스트 키 지문 등 인프라 식별 정보가 포함될 수 있습니다. 외부 공유 전에 내용을 확인하세요.', 'Detailed raw logs may contain hostnames, usernames, file paths, host-key fingerprints, and other infrastructure identifiers. Review them before sharing externally.')}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <Button
                HorizontalAlignment="Left"
                Padding="9,4"
                AutomationProperties.Name="{x:Bind h:Loc.T('표시된 원시 로그 복사', 'Copy visible raw log')}"
                Click="CopyVisible_Click"
                Content="{x:Bind h:Loc.T('표시된 원시 로그 복사', 'Copy visible raw log')}"
                FontSize="11" />
        </StackPanel>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="2"
            Height="34"
            PlaceholderText="{x:Bind h:Loc.T('호스트, 오류, 단계 검색...', 'Search host, error, or stage...')}"
            TextChanged="SearchBox_TextChanged" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="LevelFilter"
                MinWidth="132"
                HorizontalAlignment="Left"
                SelectedIndex="0"
                SelectionChanged="LevelFilter_SelectionChanged">
                <ComboBoxItem Content="{x:Bind h:Loc.T('모든 단계', 'All levels')}" />
                <ComboBoxItem Content="{x:Bind h:Loc.T('경고 및 오류', 'Warnings &amp; errors')}" />
                <ComboBoxItem Content="{x:Bind h:Loc.T('상세 로그', 'Verbose only')}" />
            </ComboBox>
            <TextBlock
                x:Name="CountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="10.5"
                Foreground="{ThemeResource TextFaint}" />
        </Grid>

        <Grid Grid.Row="4">
            <ListView
                x:Name="LogList"
                Background="Transparent"
                ItemsSource="{x:Bind Entries}"
                SelectionChanged="LogList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,7" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionLogItemVm">
                        <Border
                            Padding="9"
                            Background="{ThemeResource CardBg}"
                            BorderBrush="{ThemeResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="6,1"
                                        Background="{ThemeResource PillBg}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind LevelBrush}"
                                            Text="{x:Bind LevelText}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="9.5"
                                        Foreground="{ThemeResource TextFaint}"
                                        Text="{x:Bind TimestampText}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    FontSize="10.5"
                                    Foreground="{ThemeResource TextMuted}"
                                    Text="{x:Bind SessionText}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="9.5"
                                        Foreground="{ThemeResource AccentViolet}"
                                        Text="{x:Bind Category}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="3"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextPrimary}"
                                        Text="{x:Bind Message}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="7">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="26"
                    Foreground="{ThemeResource TextFaint}"
                    Glyph="&#xE9D9;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('표시할 연결 로그가 없습니다', 'No connection logs to display')}" />
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="DetailBox"
            Grid.Row="5"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="10.5"
            IsReadOnly="True"
            PlaceholderText="{x:Bind h:Loc.T('항목을 선택하면 전체 예외 체인이 표시됩니다.', 'Select an entry to inspect its complete exception chain.')}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
