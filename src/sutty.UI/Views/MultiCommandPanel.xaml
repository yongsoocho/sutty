<?xml version="1.0" encoding="utf-8" ?>
<!--
    Multi command 오른쪽 패널: 위 25% = 브로드캐스트 입력, 아래 75% = 저장된 커맨드.
    여기서 실행하는 모든 명령은 그리드에서 체크된 모든 세션으로 전송된다.
-->
<UserControl
    x:Class="sutty.UI.Views.MultiCommandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ── 위 25%: 브로드캐스트 입력 ──  -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="Broadcast" />

            <Grid Grid.Row="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="BroadcastBox"
                    Height="76"
                    AcceptsReturn="True"
                    CornerRadius="7"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    Padding="10,9"
                    PlaceholderText="{x:Bind h:Loc.T('체크된 모든 세션에 실행 · Enter=실행', 'Run on all checked sessions · Enter=run')}"
                    PreviewKeyDown="BroadcastBox_PreviewKeyDown"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RunBroadcastButton"
                    Grid.Row="1"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AccentGradient}"
                    BorderThickness="0"
                    Click="RunBroadcast_Click"
                    Content="Run on checked sessions"
                    CornerRadius="7"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    ToolTipService.ToolTip="Run on all checked sessions">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentGradientHover" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentGradient" />
                    </Button.Resources>
                </Button>
                <StackPanel
                    x:Name="BroadcastStatusPanel"
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="7"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="BroadcastProgress"
                        Width="14"
                        Height="14"
                        IsActive="False" />
                    <TextBlock
                        x:Name="BroadcastStatusText"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{ThemeResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  ── 체크된 SSH 세션 대상 다중 SFTP ──  -->
        <Expander
            Grid.Row="1"
            MaxHeight="300"
            HorizontalAlignment="Stretch"
                    Header="{x:Bind h:Loc.T('다중 SFTP 전송', 'Multi-server SFTP transfer')}">
            <StackPanel Padding="0,8,0,2" Spacing="7">
                <TextBox
                    x:Name="SftpRemoteDirectoryBox"
                    MinHeight="34"
                    CornerRadius="7"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11.5"
                    Header="{x:Bind h:Loc.T('원격 경로 / 업로드 대상 폴더', 'Remote path / upload destination')}"
                    PlaceholderText="/tmp"
                    Text="/tmp" />
                <Grid ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="UploadFilesButton"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Click="UploadFile_Click"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE898;" />
                            <TextBlock Text="{x:Bind h:Loc.T('파일 업로드…', 'Upload file…')}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="UploadFolderButton"
                        Grid.Column="1"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Click="UploadFolder_Click"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE8B7;" />
                            <TextBlock Text="{x:Bind h:Loc.T('폴더 업로드…', 'Upload folder…')}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Button
                    x:Name="DownloadPathButton"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Click="DownloadPath_Click"
                    CornerRadius="7">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="&#xE896;" />
                        <TextBlock Text="{x:Bind h:Loc.T('선택 서버들에서 이 경로 다운로드…', 'Download this path from selected servers…')}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="RetryFailedButton"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Click="RetryFailed_Click"
                    Content="{x:Bind h:Loc.T('실패한 서버만 재시도', 'Retry failed servers only')}"
                    CornerRadius="7"
                    Visibility="Collapsed" />
                <Button
                    x:Name="ResumePendingButton"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Click="ResumePending_Click"
                    Content="{x:Bind h:Loc.T('복원된 전송 재개', 'Resume restored transfer')}"
                    CornerRadius="7"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="SftpStatusText"
                    FontSize="10.5"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('체크한 SSH 세션만 대상이 됩니다.', 'Only checked SSH sessions are targeted.')}"
                    TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind SftpTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MultiSftpTargetVm">
                                <Border
                                    Margin="0,0,0,5"
                                    Padding="8,6"
                                    Background="{ThemeResource CardBg}"
                                    BorderBrush="{ThemeResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Grid ColumnSpacing="7" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <FontIcon
                                            Grid.RowSpan="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource AccentTeal}"
                                            Glyph="{x:Bind StateGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimary}"
                                            Text="{x:Bind DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTeal}"
                                            Text="{x:Bind ProgressText, Mode=OneWay}"
                                            TextAlignment="Right" />
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar
                                                Width="62"
                                                VerticalAlignment="Center"
                                                Maximum="1"
                                                Value="{x:Bind Progress, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="9.5"
                                                Foreground="{ThemeResource TextMuted}"
                                                Text="{x:Bind DetailText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!--  ── 아래: 저장된 커맨드 (실행 = 브로드캐스트) ──  -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                CharacterSpacing="80"
                FontSize="10.5"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextMuted}"
                Text="{x:Bind h:Loc.T('SAVED COMMANDS · 실행하면 체크된 모든 세션으로', 'SAVED COMMANDS · runs on all checked sessions')}" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,0,10">
                    <ItemsControl x:Name="CommandsList" ItemsSource="{x:Bind Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandItemVm">
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="11,9"
                                    Background="{ThemeResource CardBg}"
                                    BorderBrush="{ThemeResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimary}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                Background="{ThemeResource AccentTint}"
                                                BorderThickness="0"
                                                Click="Run_Click"
                                                CornerRadius="5"
                                                ToolTipService.ToolTip="Run on all checked sessions">
                                                <FontIcon
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AccentBlue}"
                                                    Glyph="&#xE768;" />
                                            </Button>
                                        </Grid>

                                        <TextBlock
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="10.5"
                                            Foreground="{ThemeResource TextMuted}"
                                            Text="{x:Bind CommandText}"
                                            TextWrapping="Wrap" />

                                        <!--  $n 입력칸: Run을 누르면 펼쳐진다  -->
                                        <StackPanel Spacing="6" Visibility="{x:Bind ShowParams, Mode=OneWay}">
                                            <ItemsControl ItemsSource="{x:Bind Params}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CommandParamVm">
                                                    <TextBox
                                                            Margin="0,0,0,6"
                                                            MinHeight="32"
                                                            CornerRadius="6"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="11.5"
                                                            PlaceholderText="{x:Bind Label}"
                                                            Text="{x:Bind Value, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Background="{ThemeResource AccentGradient}"
                                                BorderThickness="0"
                                                Click="Execute_Click"
                                                Content="Run"
                                                CornerRadius="6"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentGradientHover" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentGradient" />
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextMuted}"
                        Text="{x:Bind h:Loc.T('저장된 명령이 없습니다 — Command 탭에서 추가하세요', 'No saved commands — add them in the Command tab')}"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
