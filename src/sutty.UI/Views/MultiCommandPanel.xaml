<?xml version="1.0" encoding="utf-8" ?>
<!--
    Multi command 오른쪽 패널: 위 25% = 브로드캐스트 입력, 아래 75% = 저장된 커맨드.
    여기서 실행하는 모든 명령은 그리드에서 체크된 모든 세션으로 전송된다.
-->
<UserControl
    x:Class="sutty.UI.Views.MultiCommandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MinHeight="120" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <!--  ── 위 25%: 브로드캐스트 입력 ──  -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{ThemeResource AccentViolet}" Style="{StaticResource HeaderDot}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="Broadcast" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="BroadcastBox"
                    VerticalAlignment="Stretch"
                    AcceptsReturn="True"
                    CornerRadius="8"
                    FontSize="13"
                    PlaceholderText="{x:Bind h:Loc.T('체크된 모든 세션에 실행 · Enter=실행', 'Run on all checked sessions · Enter=run')}"
                    PreviewKeyDown="BroadcastBox_PreviewKeyDown"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Width="44"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource AccentBlue}"
                    Click="RunBroadcast_Click"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Run on all checked sessions">
                    <FontIcon
                        FontSize="14"
                        Foreground="#FFFFFF"
                        Glyph="&#xE768;" />
                </Button>
            </Grid>
        </Grid>

        <!--  ── 아래 75%: 저장된 커맨드 (실행 = 브로드캐스트) ──  -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFaint}"
                Text="{x:Bind h:Loc.T('SAVED COMMANDS · 실행하면 체크된 모든 세션으로', 'SAVED COMMANDS · runs on all checked sessions')}" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,0,12">
                    <ItemsControl x:Name="CommandsList" ItemsSource="{x:Bind Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandItemVm">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{ThemeResource CardBg}"
                                    BorderBrush="{ThemeResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimary}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Padding="6,4"
                                                Background="{ThemeResource PillBg}"
                                                BorderBrush="{ThemeResource CardBorder}"
                                                Click="Run_Click"
                                                CornerRadius="6"
                                                ToolTipService.ToolTip="Run on all checked sessions">
                                                <FontIcon
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AccentBlue}"
                                                    Glyph="&#xE768;" />
                                            </Button>
                                        </Grid>

                                        <TextBlock
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextMuted}"
                                            Text="{x:Bind CommandText}"
                                            TextWrapping="Wrap" />

                                        <!--  $n 입력칸: Run을 누르면 펼쳐진다  -->
                                        <StackPanel Spacing="6" Visibility="{x:Bind ShowParams, Mode=OneWay}">
                                            <ItemsControl ItemsSource="{x:Bind Params}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CommandParamVm">
                                                        <TextBox
                                                            Margin="0,0,0,6"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="12"
                                                            PlaceholderText="{x:Bind Label}"
                                                            Text="{x:Bind Value, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Background="{ThemeResource AccentBlue}"
                                                Click="Execute_Click"
                                                Content="Run"
                                                CornerRadius="6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFaint}"
                        Text="{x:Bind h:Loc.T('저장된 명령이 없습니다 — Command 탭에서 추가하세요', 'No saved commands — add them in the Command tab')}"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
