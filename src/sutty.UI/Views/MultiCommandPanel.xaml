<?xml version="1.0" encoding="utf-8" ?>
<!--
    Multi command 오른쪽 패널: 브로드캐스트 입력과 공용 명령 라이브러리.
    여기서 실행하는 모든 명령은 그리드에서 체크된 모든 세션으로 전송된다.
-->
<UserControl
    x:Class="sutty.UI.Views.MultiCommandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:sutty.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="using:sutty.UI.Helpers"
    xmlns:local="using:sutty.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:sutty.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowSpacing="12" Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── 체크한 세션에 명령 입력 ──  -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimary}"
                Text="{x:Bind h:Loc.T('명령 일괄 실행', 'Broadcast command')}" />

            <Grid Grid.Row="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="BroadcastBox"
                    Height="76"
                    AcceptsReturn="True"
                    CornerRadius="7"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    Padding="10,9"
                    PlaceholderText="{x:Bind h:Loc.T('Sutty SSH 선택 대상 · Enter=실행 확인', 'Selected Sutty SSH targets · Enter=review')}"
                    PreviewKeyDown="BroadcastBox_PreviewKeyDown"
                    TextChanged="BroadcastBox_TextChanged"
                    TextWrapping="Wrap" />
                <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"
                    Text="{x:Bind h:Loc.T('독립 SSH exec · 터미널의 cd·환경변수·sudo 상태를 공유하지 않습니다. 응답은 최대 60초 기다립니다.', 'Independent SSH exec · terminal cd, environment and sudo state are not shared. Waits up to 60 seconds.')}" />
                <Button
                    x:Name="RunBroadcastButton"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AccentGradient}"
                    BorderThickness="0"
                    Click="RunBroadcast_Click"
                    Content="{x:Bind h:Loc.T('대상·명령 확인 후 실행', 'Review targets and command')}"
                    CornerRadius="7"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentForeground}"
                    ToolTipService.ToolTip="{x:Bind h:Loc.T('체크한 모든 세션에서 실행', 'Run on all checked sessions')}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentGradientHover" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentGradient" />
                    </Button.Resources>
                </Button>
                <Button x:Name="StopBroadcastButton" HorizontalAlignment="Stretch"
                    Visibility="Collapsed" Click="StopBroadcast_Click"
                    Content="{x:Bind h:Loc.T('취소 요청 · 대기 종료', 'Request cancellation · stop waiting')}"
                    ToolTipService.ToolTip="{x:Bind h:Loc.T('원격 작업 종료는 보장되지 않습니다. 서버에서 결과를 확인하세요. 자동 재실행하지 않습니다.', 'Remote termination is not guaranteed. Check the server result. No automatic replay.')}" />
                </StackPanel>
                <controls:WrapPanel
                    x:Name="BroadcastStatusPanel"
                    Grid.Row="2"
                    Spacing="7"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="BroadcastProgress"
                        Width="14"
                        Height="14"
                        IsActive="False" />
                    <TextBlock
                        x:Name="BroadcastStatusText"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="10.5"
                        Foreground="{ThemeResource TextMuted}" />
                </controls:WrapPanel>
            </Grid>
        </Grid>

        <local:CommandPanel
            x:Name="CommandLibrary"
            Grid.Row="1" />

        <!--  ── 체크된 SSH 세션 대상 다중 SFTP ──  -->
        <Expander
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="{x:Bind h:Loc.T('다중 SFTP 전송', 'Multi-server SFTP transfer')}">
            <StackPanel Padding="0,8,0,2" Spacing="7">
                <TextBox
                    x:Name="SftpRemoteDirectoryBox"
                    MinHeight="34"
                    CornerRadius="7"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11.5"
                    Header="{x:Bind h:Loc.T('원격 경로 / 업로드 대상 폴더', 'Remote path / upload destination')}"
                    PlaceholderText="/tmp"
                    Text="/tmp" />
                <StackPanel Spacing="7">
                    <Button
                        x:Name="UploadFilesButton"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Click="UploadFile_Click"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE898;" />
                            <TextBlock Text="{x:Bind h:Loc.T('파일 업로드…', 'Upload file…')}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="UploadFolderButton"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Click="UploadFolder_Click"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE8B7;" />
                            <TextBlock Text="{x:Bind h:Loc.T('폴더 업로드…', 'Upload folder…')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="DownloadPathButton"
                    MinHeight="32"
                    HorizontalAlignment="Stretch"
                    Click="DownloadPath_Click"
                    CornerRadius="7">
                    <TextBlock Text="{x:Bind h:Loc.T('선택 서버들에서 이 경로 다운로드…', 'Download this path from selected servers…')}" TextWrapping="Wrap" />
                </Button>
                <Button
                    x:Name="RetryFailedButton"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Click="RetryFailed_Click"
                    Content="{x:Bind h:Loc.T('실패한 서버만 재시도', 'Retry failed servers only')}"
                    CornerRadius="7"
                    Visibility="Collapsed" />
                <Button
                    x:Name="ResumePendingButton"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Click="ResumePending_Click"
                    Content="{x:Bind h:Loc.T('복원된 전송 재개', 'Resume restored transfer')}"
                    CornerRadius="7"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="SftpStatusText"
                    FontSize="10.5"
                    Foreground="{ThemeResource TextMuted}"
                    Text="{x:Bind h:Loc.T('체크한 SSH 세션만 대상이 됩니다.', 'Only checked SSH sessions are targeted.')}"
                    TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind SftpTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MultiSftpTargetVm">
                                <Border
                                    Margin="0,0,0,5"
                                    Padding="8,6"
                                    Background="{ThemeResource CardBg}"
                                    BorderBrush="{ThemeResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Grid ColumnSpacing="7" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <FontIcon
                                            Grid.RowSpan="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource AccentTeal}"
                                            Glyph="{x:Bind StateGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimary}"
                                            Text="{x:Bind DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTeal}"
                                            Text="{x:Bind ProgressText, Mode=OneWay}"
                                            TextAlignment="Right" />
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar
                                                Width="62"
                                                VerticalAlignment="Center"
                                                Maximum="1"
                                                Value="{x:Bind Progress, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="9.5"
                                                Foreground="{ThemeResource TextMuted}"
                                                Text="{x:Bind DetailText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Expander>

    </Grid>
    </ScrollViewer>
</UserControl>
